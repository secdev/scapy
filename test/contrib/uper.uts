= uper codec oid roundtrip
import scapy.all  # noqa: F401  # loads conf.mib for ASN1_OID

for oid in ("1.2.3", "1.2.840.113549"):
    data = UPERcodec_OID.enc(oid)
    decoded, remain = UPERcodec_OID.do_dec(data)
    assert remain == b""
    assert decoded.val == oid

True

