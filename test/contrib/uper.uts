def _assert_codec_roundtrip(codec, value, kwargs, expected):
    # type: (Type[Any], Any, Dict[str, Any], Any) -> None
    data = codec.enc(value, **kwargs)
    decoded, _remain = codec.do_dec(data, **kwargs)
    assert decoded.val == expected

