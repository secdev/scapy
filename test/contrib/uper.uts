def _encode_choice_int1_10():
    # type: () -> bytes
    enc = UPER_Encoder()
    UPER_choice_index_enc(enc, 0, 5)
    UPERcodec_INTEGER.encode_into(enc, 10, uper_min=0, uper_max=15)
    return enc.as_bytes()

