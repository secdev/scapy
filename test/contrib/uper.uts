= uper fuzz encode
iterations = 25

for cls in _fuzz_packets():
    for _ in range(iterations):
        try:
            data = raw(fuzz(cls()))
        except _DECODE_ERRORS:
            continue
        assert isinstance(data, bytes)

True

= uper fuzz roundtrip
iterations = 25

for cls in _fuzz_packets():
    for _ in range(iterations):
        try:
            cls(raw(fuzz(cls())))
        except _DECODE_ERRORS:
            pass

True

= uper fuzz codec decode
iterations = 100

for codec in _UPER_CODEC_CLASSES:
    for _ in range(iterations):
        data = os.urandom(random.randint(0, 64))
        try:
            codec.safedec(data)
        except _DECODE_ERRORS:
            pass

True

