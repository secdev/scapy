% Regression tests for J1939 64-bit NAME (J1939-81)
~ automotive_comm

+ Configuration
~ conf

= Imports
from scapy.contrib.automotive.j1939 import (
    J1939Name,
    J1939_INDUSTRY_GROUPS,
    J1939_INDUSTRY_SPECIFIC_FUNCTIONS,
    J1939_INDUSTRY_SPECIFIC_VEHICLE_SYSTEMS,
    J1939_MANUFACTURERS,
    J1939_PRE_ASSIGNED_FUNCTIONS,
    j1939_format_name_function,
    j1939_format_name_industry_group,
    j1939_format_name_manufacturer,
    j1939_format_name_vehicle_system,
)

= J1939 registries have expected entries
assert 1 in J1939_INDUSTRY_GROUPS
assert 0 in J1939_PRE_ASSIGNED_FUNCTIONS
assert J1939_PRE_ASSIGNED_FUNCTIONS[0] == "Engine"
assert 1 in J1939_INDUSTRY_SPECIFIC_FUNCTIONS
assert 1 in J1939_INDUSTRY_SPECIFIC_VEHICLE_SYSTEMS
assert 161 in J1939_MANUFACTURERS
assert 10 in J1939_PRE_ASSIGNED_FUNCTIONS
assert J1939_PRE_ASSIGNED_FUNCTIONS[10] == "Brakes - Steer Axle"
assert 81 in J1939_PRE_ASSIGNED_FUNCTIONS
assert 82 not in J1939_PRE_ASSIGNED_FUNCTIONS
assert j1939_format_name_function(82) == "Pre-Assigned / Reserved Function (82)"
assert j1939_format_name_function(85) == "Pre-Assigned / Reserved Function (85)"


+ J1939Name Packet tests

= J1939Name: default size is 8 bytes
pkt = J1939Name()
assert len(bytes(pkt)) == 8

= J1939Name: round trip build and dissect
pkt = J1939Name(
    arbitrary_address_capable=1,
    industry_group=1,
    vehicle_system_instance=2,
    vehicle_system=3,
    reserved=0,
    function=0,
    function_instance=1,
    ecu_instance=2,
    manufacturer_code=161,
    identity_number=42,
)
raw = bytes(pkt)
assert len(raw) == 8
decoded = J1939Name(raw)
assert decoded.arbitrary_address_capable == 1
assert decoded.industry_group == 1
assert decoded.vehicle_system_instance == 2
assert decoded.vehicle_system == 3
assert decoded.reserved == 0
assert decoded.function == 0
assert decoded.function_instance == 1
assert decoded.ecu_instance == 2
assert decoded.manufacturer_code == 161
assert decoded.identity_number == 42

= J1939Name: format helpers and descriptions
pkt = J1939Name(
    arbitrary_address_capable=1,
    industry_group=1,
    vehicle_system=1,
    function=0,
    manufacturer_code=161,
    identity_number=100,
)
assert j1939_format_name_function(pkt) == "Engine"
assert j1939_format_name_function(pkt.function, pkt.industry_group) == "Engine"
assert "Volvo" in j1939_format_name_manufacturer(pkt)
assert "Volvo" in j1939_format_name_manufacturer(pkt.manufacturer_code)
assert "On-Highway" in j1939_format_name_industry_group(pkt)
assert "On-Highway" in j1939_format_name_industry_group(pkt.industry_group)
assert j1939_format_name_function(10) == "Brakes - Steer Axle"
assert j1939_format_name_industry_group(1) == "On-Highway Equipment (Trucks, Buses, Coaches)"
assert j1939_format_name_industry_group(99) == "99"
assert j1939_format_name_manufacturer(161) == "Volvo Lastvagnar AB"
assert j1939_format_name_manufacturer(9999) == "9999"
assert isinstance(j1939_format_name_vehicle_system(pkt), str)
assert isinstance(j1939_format_name_vehicle_system(pkt.vehicle_system, pkt.industry_group), str)
assert isinstance(pkt.raw_value(), int)
assert "On-Highway" in pkt.sprintf("%J1939Name.industry_group%")
assert pkt.sprintf("%J1939Name.manufacturer_code%") == "Volvo Lastvagnar AB"

= J1939Name: summary and mysummary
assert "Engine" in pkt.mysummary()
assert "Engine" in pkt.summary()

= J1939Name: show output
output = pkt.show(dump=True)
assert "arbitrary_address_capable" in output
assert "manufacturer_code" in output
assert "identity_number" in output

= J1939Name: function descriptions (pre-assigned, industry-specific, error, not available)
pkt_ind = J1939Name(function=130, industry_group=1)
assert "Function 130" in j1939_format_name_function(pkt_ind) or pkt_ind.function == 130

pkt_err = J1939Name(function=254)
assert j1939_format_name_function(pkt_err) == "Error State"

pkt_na = J1939Name(function=255)
assert j1939_format_name_function(pkt_na) == "Not Available State"

= Socket integration: wrap J1939Name in J1939 frame
from scapy.contrib.j1939 import J1939, J1939_PGN_ADDRESS_CLAIMED
name_pkt = J1939Name(identity_number=42, manufacturer_code=161)
frame = J1939(pgn=J1939_PGN_ADDRESS_CLAIMED, data=bytes(name_pkt))
parsed = J1939Name(frame.data)
assert parsed.identity_number == 42
assert parsed.manufacturer_code == 161


= J1939Name: constructor from pre-converted byte formats
from scapy.layers.can import CAN

val = 0x9000000000000001
res_int = J1939Name(val.to_bytes(8, "little"))
res_hex = J1939Name(bytes.fromhex("0100000000000090"))
res_hex_0x = J1939Name(bytes.fromhex("0x0100000000000090".replace("0x", "")))
res_bytes = J1939Name(b"\x01\x00\x00\x00\x00\x00\x00\x90")
can_pkt = CAN(data=b"\x01\x00\x00\x00\x00\x00\x00\x90")
res_can = J1939Name(bytes(can_pkt.data))
assert res_int.raw_value() == res_hex.raw_value() == res_hex_0x.raw_value() == res_bytes.raw_value() == res_can.raw_value()
assert res_int.identity_number == 1
assert res_int.arbitrary_address_capable == 1


+ j1939_name_arbitration tests

= j1939_name_arbitration: lower numerical value wins
def j1939_name_arbitration(name1, name2):
    pkt1 = name1 if isinstance(name1, J1939Name) else J1939Name(name1)
    pkt2 = name2 if isinstance(name2, J1939Name) else J1939Name(name2)
    val1 = pkt1.raw_value()
    val2 = pkt2.raw_value()
    if val1 == val2:
        return {"winner": None, "loser": None, "collision": True}
    if val1 < val2:
        winner, loser = "ECU A", "ECU B"
        win_pkt, lose_pkt = pkt1, pkt2
    else:
        winner, loser = "ECU B", "ECU A"
        win_pkt, lose_pkt = pkt2, pkt1
    return {
        "winner": winner,
        "loser": loser,
        "win_name": win_pkt,
        "lose_name": lose_pkt,
        "collision": False,
    }

simulate_arbitration = j1939_name_arbitration

name_a = b"\x01\x00\x00\x00\x00\x00\x00\x10"
name_b = b"\x02\x00\x00\x00\x00\x00\x00\x10"
res = j1939_name_arbitration(name_a, name_b)
assert res["winner"] == "ECU A"
assert res["loser"] == "ECU B"
assert res["collision"] is False
assert isinstance(res["win_name"], J1939Name)
assert isinstance(res["lose_name"], J1939Name)

= j1939_name_arbitration: collision detection
res = j1939_name_arbitration(name_a, name_a)
assert res["collision"] is True
assert res["winner"] is None

= j1939_name_arbitration: ECU B wins and arbitrary address capable loser
name_a = b"\x02\x00\x00\x00\x00\x00\x00\x90"  # Bit 63 = 1
name_b = b"\x01\x00\x00\x00\x00\x00\x00\x90"  # Bit 63 = 1, lower value
res = j1939_name_arbitration(name_a, name_b)
assert res["winner"] == "ECU B"
assert res["loser"] == "ECU A"


= J1939Name dissects truncated and short frames gracefully
from scapy.config import conf
_old_dbg = conf.debug_dissector
try:
    conf.debug_dissector = True
    _j_name_short = J1939(b"X", pgn=J1939_PGN_ADDRESS_CLAIMED, dst=0xFF)
    assert not _j_name_short.haslayer(J1939Name)
    assert _j_name_short.data == b"X"
    _j_name_ok = J1939(b"\x00" * 8, pgn=J1939_PGN_ADDRESS_CLAIMED, dst=0xFF)
    assert _j_name_ok.haslayer(J1939Name)
finally:
    conf.debug_dissector = _old_dbg

= J1939Name payload dissection and stacking
from scapy.packet import Raw
name_raw = J1939Name(bytes(J1939Name()) + b"trailing_payload")
assert name_raw.haslayer(Raw)
assert name_raw[Raw].load == b"trailing_payload"

True

