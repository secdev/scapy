= Socket filter configuration error detection and warning flood prevention
from unittest.mock import patch
from scapy.contrib.automotive.j1939.j1939_scanner import j1939_check_rx_filter_warning, j1939_sa_filter
from scapy.contrib.j1939 import j1939_to_can_id
from scapy.contrib.j1939 import log_j1939
from test.testsocket import TestSocket, cleanup_testsockets

# 1. Unfiltered socket receiving unexpected SA traffic: emits warning once, no flood
unfiltered_sock = TestSocket(CAN)
warn_msgs = []
with patch.object(log_j1939, "warning", side_effect=lambda msg, *args: warn_msgs.append(msg % args if args else msg)):
    # Feed 5 noise packets from unexpected SA=0x99
    for _ in range(5):
        noise_can = CAN(identifier=j1939_to_can_id(6, 0, 0, 0xEE, 0xFF, 0x99), flags="extended", data=b"\x00" * 8)
        j1939_check_rx_filter_warning(noise_can, 0x10, [unfiltered_sock])

assert len(warn_msgs) == 1, "Expected exactly 1 warning despite multiple noise packets, got %d" % len(warn_msgs)
assert "0x10" in warn_msgs[0]
cleanup_testsockets()

# 2. Socket receiving unexpected frames during scan: detects incorrect socket and emits warning
mismatched_sock = TestSocket(CAN)
warn_msgs_scan = []
with patch.object(log_j1939, "warning", side_effect=lambda msg, *args: warn_msgs_scan.append(msg % args if args else msg)):
    # Feed noise packet from unexpected SA=0x99
    noise_can = CAN(identifier=j1939_to_can_id(6, 0, 0, 0xEE, 0xFF, 0x99), flags="extended", data=b"\x00" * 8)
    j1939_check_rx_filter_warning(noise_can, 0x10, [mismatched_sock])

assert len(warn_msgs_scan) == 1, "Expected exactly 1 warning across scan, got %d" % len(warn_msgs_scan)
assert "0x10" in warn_msgs_scan[0]
cleanup_testsockets()

# 3. Socket receiving expected frames: no warnings emitted
matching_sock = TestSocket(CAN)
warn_msgs_ok = []
with patch.object(log_j1939, "warning", side_effect=lambda msg, *args: warn_msgs_ok.append(msg % args if args else msg)):
    expected_can = CAN(identifier=j1939_to_can_id(6, 0, 0, 0xEE, 0xFF, 0x10), flags="extended", data=b"\x00" * 8)
    j1939_check_rx_filter_warning(expected_can, 0x10, [matching_sock])

assert len(warn_msgs_ok) == 0, "Expected no warnings for matching target SA, got %d" % len(warn_msgs_ok)
cleanup_testsockets()
True

= j1939_scan: socket bitrate detection, invalid bitrate fallback, and probe cleanup
from scapy.contrib.automotive.j1939.j1939_scanner import j1939_scan
from test.testsocket import TestSocket, cleanup_testsockets

mock_sock = TestSocket(CAN)
mock_sock.bitrate = "invalid_bitrate"
res = j1939_scan(mock_sock, methods=["addr_claim"], src_addrs=[0xF9],
                 broadcast_listen_time=0.01, noise_ids=set())
assert isinstance(res, dict)

def reconnect_with_bitrate():
    s = TestSocket(CAN)
    s.bitrate = 500000
    return s

res2 = j1939_scan(mock_sock, methods=["addr_claim"], src_addrs=[0xF9],
                  broadcast_listen_time=0.01, noise_ids=set(),
                  reconnect_handler=reconnect_with_bitrate)
assert isinstance(res2, dict)

_first_call = True
def reconnect_with_failing_close():
    global _first_call
    s = TestSocket(CAN)
    s.bitrate = 250000
    if _first_call:
        _first_call = False
        def bad_close():
            s.close = lambda: None
            raise OSError("cannot close probe")
        s.close = bad_close
    return s

res3 = j1939_scan(mock_sock, methods=["addr_claim"], src_addrs=[0xF9],
                  broadcast_listen_time=0.01, noise_ids=set(),
                  reconnect_handler=reconnect_with_failing_close)
assert isinstance(res3, dict)
cleanup_testsockets()
True

