+ addr_claim – noise filtering

= addr_claim: noise SAs are filtered from broadcast results
def test_addr_claim_noise_filtering():
    class FilterSocket(TestSocket):
        def send(self, pkt):
            super(FilterSocket, self).send(pkt)
            can_id = getattr(pkt, "identifier", None)
            if can_id is not None:
                f = can_id_to_j1939(can_id); pf, ps, sa = f['pdu_format'], f['pdu_specific'], f['src']
                if pf == J1939_PF_REQUEST:
                    for sa_val in [0x10, 0x11]:
                        resp_can_id = j1939_to_can_id(6, 0, 0, J1939_PF_ADDRESS_CLAIMED, J1939_GLOBAL_ADDRESS, sa_val)
                        self.ins.send(bytes(CAN(identifier=resp_can_id, flags="extended",
                                                data=b'\x00' * 8)))
    sock = FilterSocket(CAN)
    found = j1939_scan_addr_claim(sock, listen_time=0.1, noise_ids={0x10})
    assert 0x10 not in found, "SA=0x10 is noise and must be suppressed"
    assert 0x11 in found, "SA=0x11 (not noise) should be found"
    cleanup_testsockets()

test_addr_claim_noise_filtering()

