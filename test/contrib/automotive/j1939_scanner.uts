= uds: both functional and physical responses are captured
def test_uds_both_functional_and_physical():
    class DualUdsSocket(TestSocket):
        def __init__(self, *args, **kwargs):
            super(DualUdsSocket, self).__init__(*args, **kwargs)
            self.replied_f = False
        def send(self, pkt):
            super(DualUdsSocket, self).send(pkt)
            can_id = getattr(pkt, "identifier", None)
            if can_id is not None:
                f = can_id_to_j1939(can_id); pf, ps, sa = f['pdu_format'], f['pdu_specific'], f['src']
                if pf == J1939_PF_DIAG_B and not self.replied_f:
                    self.replied_f = True
                    resp_f = j1939_to_can_id(6, 0, 0, J1939_PF_DIAG_B, sa, 0x55)
                    self.ins.send(bytes(CAN(identifier=resp_f, flags="extended",
                                            data=b'\x02\x7e\x00')))
                elif pf == J1939_PF_DIAG_A and ps == 0x55:
                    resp_p = j1939_to_can_id(6, 0, 0, J1939_PF_DIAG_A, sa, 0x55)
                    self.ins.send(bytes(CAN(identifier=resp_p, flags="extended",
                                            data=b'\x02\x7e\x00')))
    sock = DualUdsSocket(CAN)
    found = j1939_scan_uds(sock, scan_range=[0x55], sniff_time=0.1,
                           broadcast_listen_time=0.1,
                           noise_ids=set(), src_addrs=[0xF9])
    assert 0x55 in found
    # Should have captured both responses
    assert len(found[0x55]) == 2
    # Check PFs
    pfs = {can_id_to_j1939(p.packet.to_can_id())["pdu_format"] for p in found[0x55]}
    assert pfs == {J1939_PF_DIAG_A, J1939_PF_DIAG_B}
    cleanup_testsockets()

test_uds_both_functional_and_physical()

= uds: skip_functional=True avoids broadcast probes
def test_uds_skip_functional():
    with TestSocket(CAN) as tx_sock, TestSocket(CAN) as monitor:
        tx_sock.pair(monitor)
        j1939_scan_uds(tx_sock, scan_range=[0x20], sniff_time=0.0,
                       skip_functional=True,
                       noise_ids=set(), src_addrs=[0xF9])
        pkts = monitor.sniff(count=10, timeout=0.2)
        # Should only see 2 probe frames (the physical unicast ones for 3E00 and 3E01)
        assert len(pkts) == 2, "Expected 2 probes (physical), got {}".format(len(pkts))
        for p in pkts:
            f = can_id_to_j1939(p.identifier); pf, ps = f['pdu_format'], f['pdu_specific']
            assert pf == J1939_PF_DIAG_A
    cleanup_testsockets()

test_uds_skip_functional()

= uds: custom diag_pgn uses expected PF and PF|0x01
def test_uds_custom_diag_pgn():
    with TestSocket(CAN) as tx_sock, TestSocket(CAN) as monitor:
        tx_sock.pair(monitor)
        custom_pgn = 0xD0
        j1939_scan_uds(tx_sock, scan_range=[0x20], sniff_time=0.0,
                       diag_pgn=custom_pgn,
                       noise_ids=set(), src_addrs=[0xF9])
        pkts = monitor.sniff(count=4, timeout=0.2)
        assert len(pkts) == 4
        
        # Functional probes
        func_pfs = [can_id_to_j1939(p.identifier)["pdu_format"] for p in pkts[:2]]
        assert all(pf == custom_pgn | 0x01 for pf in func_pfs)
        # Physical probes
        phys_pfs = [can_id_to_j1939(p.identifier)["pdu_format"] for p in pkts[2:]]
        assert all(pf == custom_pgn for pf in phys_pfs)
    cleanup_testsockets()

test_uds_custom_diag_pgn()

