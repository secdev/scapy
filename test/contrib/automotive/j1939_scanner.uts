        super().send(pkt)
        claim_pkt = j1939_to_can_id(6, 0, 0, 0xEE, 0xFF, 0x40)
        self.ins.send(bytes(CAN(identifier=claim_pkt, flags="extended", data=b"\x00"*8)))

