def test_pacing_negative_busload():
    try:
        j1939_inter_probe_delay(250000, -0.1, 3, 8, 0.1)
        assert False, "Expected ValueError"
    except ValueError as e:
        assert "busload" in str(e).lower(), str(e)

test_pacing_negative_busload()

= j1939_inter_probe_delay: busload=1.0 accepted and yields minimal delay
d = j1939_inter_probe_delay(250000, 1.0, 3, 8, 0.0)
expected = (91 + 131) / (250000 * 1.0)
assert abs(d - expected) < 1e-9

