test_j1939_scan_uds_technique()

= j1939_scan_uds: 7F 3E negative response confirms UDS support
from scapy.contrib.automotive.j1939.j1939_scanner import j1939_scan_uds
from scapy.contrib.automotive.uds import UDS, UDS_NR
from scapy.contrib.j1939 import j1939_to_can_id
from scapy.layers.can import CAN
from test.testsocket import TestSocket, cleanup_testsockets

# Physical probe response: 7F 3E 22 (conditionsNotCorrect) confirms endpoint supports UDS
sock_phys = TestSocket(CAN)
resp_can_id_phys = j1939_to_can_id(6, 0, 0, J1939_PF_DIAG_A, 0xF1, 0x40)
sock_phys.ins.send(bytes(CAN(identifier=resp_can_id_phys, flags="extended",
                             data=b"\x03\x7f\x3e\x22\xff\xff\xff\xff")))
found_phys = j1939_scan_uds(sock_phys, scan_range=[0x40], src_addrs=[0xF1],
                            sniff_time=0.1, skip_functional=True)
assert 0x40 in found_phys
cleanup_testsockets()

# Functional broadcast probe response: 7F 3E 12 (subFunctionNotSupported) confirms endpoint supports UDS
sock_func = TestSocket(CAN)
resp_can_id_func = j1939_to_can_id(6, 0, 0, J1939_PF_DIAG_B, 0xF1, 0x50)
sock_func.ins.send(bytes(CAN(identifier=resp_can_id_func, flags="extended",
                             data=b"\x7f\x3e\x12\x00\x00\x00\x00\x00")))
found_func = j1939_scan_uds(sock_func, scan_range=[0x50], src_addrs=[0xF1],
                            broadcast_listen_time=0.1, sniff_time=0.01)
assert 0x50 in found_func
cleanup_testsockets()

True

= j1939_scan: SA found by addr_claim and uds accumulates both methods and packets
def test_j1939_scan_addr_claim_and_uds():
    class DualMethodSocket(TestSocket):
        def send(self, pkt):
            super(DualMethodSocket, self).send(pkt)
            can_id = getattr(pkt, "identifier", None)
            if can_id is not None:
                f = can_id_to_j1939(can_id); pf, ps, sa = f['pdu_format'], f['pdu_specific'], f['src']
                if pf == J1939_PF_REQUEST:
                    resp = j1939_to_can_id(6, 0, 0, J1939_PF_ADDRESS_CLAIMED, J1939_GLOBAL_ADDRESS, 0x41)
                    self.ins.send(bytes(CAN(identifier=resp, flags="extended",
                                            data=b'\x00' * 8)))
                elif pf == J1939_PF_DIAG_A and ps == 0x41:
                    resp = j1939_to_can_id(6, 0, 0, J1939_PF_DIAG_A, sa, 0x41)
                    self.ins.send(bytes(CAN(identifier=resp, flags="extended",
                                            data=b'\x02\x7e\x00')))
    sock = DualMethodSocket(CAN)
    found = j1939_scan(sock, methods=["addr_claim", "uds"],
                       scan_range=[0x41],
                       broadcast_listen_time=0.1, sniff_time=0.1,
                       noise_ids=set(), src_addrs=[0xF9],
                       skip_functional=True)
    assert 0x41 in found
    assert "addr_claim" in found[0x41]["methods"]
    assert "uds" in found[0x41]["methods"]
    assert found[0x41]["methods"][0] == "addr_claim"
    assert len(found[0x41]["packets"]) == 2, \
        "Two methods found SA=0x41; packets list must have 2 entries"
    assert isinstance(found[0x41]["packets"][0], list)
    assert isinstance(found[0x41]["packets"][1], list)
    # Check src_addrs - [[0xF9]] for addr_claim (broadcast), [[0xF9]] for unicast (physical)
    assert found[0x41]["src_addrs"] == [[0xF9], [0xF9]], \
        "Expected [[0xF9], [0xF9]], got: {}".format(found[0x41]["src_addrs"])
    cleanup_testsockets()

test_j1939_scan_addr_claim_and_uds()

= uds: captures all responding scanner source addresses in range
def test_uds_captures_all_responding_src_addrs():
    sock = TestSocket(CAN)
    _TARGET_DA = 0x45
    _SRC_ADDRS = list(range(0xF1, 0xFB))
    for sa in _SRC_ADDRS:
        resp_can_id = j1939_to_can_id(6, 0, 0, J1939_PF_DIAG_A, sa, _TARGET_DA)
        sock.ins.send(bytes(CAN(identifier=resp_can_id, flags="extended",
                                data=b'\x02\x7e\x00')))
    found = j1939_scan_uds(sock, scan_range=[_TARGET_DA],
                           src_addrs=range(0xF1, 0xFB),
                           sniff_time=0.2, noise_ids=set(),
                           skip_functional=True)
    assert _TARGET_DA in found
    captured_sas = sorted({
        p.scanner_src for p in found[_TARGET_DA]
    })
    assert captured_sas == _SRC_ADDRS, \
        "Expected all SAs 0xF1..0xFA, got: {}".format([hex(x) for x in captured_sas])
    # Also verify that p.packet holds the raw J1939 frame
    decoded_sas = sorted({
        can_id_to_j1939(p.packet.to_can_id())["pdu_specific"] for p in found[_TARGET_DA]
    })
    assert decoded_sas == _SRC_ADDRS
    cleanup_testsockets()

test_uds_captures_all_responding_src_addrs()

