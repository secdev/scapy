cleanup_testsockets()

slow_sock_xcp = SlowTestSocket(
    CAN,
    frame_delay=0.005,
    mux_throttle=0.001,
    serial_timeout=0.1,
    read_time_limit=0.02,
    interface_name="slcan",
)
