= J1939_Scanner default_test_case_clss and merging multiple results
from scapy.layers.can import CAN
from test.testsocket import TestSocket, cleanup_testsockets
from scapy.contrib.automotive.j1939.j1939_scanner import (
    J1939_Scanner,
    J1939_AddrClaim_TestCase,
    J1939_EcuId_TestCase,
    J1939_Unicast_TestCase,
    J1939_RtsProbe_TestCase,
    J1939_UDS_TestCase,
    J1939_XCP_TestCase,
    J1939ScanResult,
)
from scapy.contrib.j1939 import J1939
sock = TestSocket(CAN)
scanner = J1939_Scanner(sock)
assert len(scanner.default_test_case_clss) == 6

# Multi-result merging for the same SA
tc1 = J1939_AddrClaim_TestCase()
tc1.results = {0x10: [J1939ScanResult(J1939(), scanner_src=0xF1)]}
tc2 = J1939_Unicast_TestCase()
tc2.results = {0x10: [J1939ScanResult(J1939(), scanner_src=0xF2)]}
scanner_multi = J1939_Scanner(sock, test_cases=[tc1, tc2])
res_multi = scanner_multi.get_results()
assert 0x10 in res_multi
assert len(res_multi[0x10]["methods"]) == 2
assert "addr_claim" in res_multi[0x10]["methods"]
assert "unicast" in res_multi[0x10]["methods"]
cleanup_testsockets()

= J1939_CA_TestCase execution via J1939_Scanner
from scapy.layers.can import CAN
from test.testsocket import TestSocket, cleanup_testsockets
from scapy.contrib.automotive.j1939.j1939_scanner import (
    J1939_Scanner,
    J1939_AddrClaim_TestCase,
    J1939_EcuId_TestCase,
    J1939_RtsProbe_TestCase,
    J1939_UDS_TestCase,
    J1939_XCP_TestCase,
)
for cls in [
    J1939_AddrClaim_TestCase,
    J1939_EcuId_TestCase,
    J1939_RtsProbe_TestCase,
    J1939_UDS_TestCase,
    J1939_XCP_TestCase,
]:
    tc = cls()
    assert tc.supported_responses == []
    s = TestSocket(CAN)
    kwargs = {
        "{}_kwargs".format(cls.__name__): {
            "broadcast_listen_time": 0.01,
            "sniff_time": 0.01,
            "scan_range": [0x10],
            "src_addrs": [0xF9],
        }
    }
    sc = J1939_Scanner(s, scan_range=[0x10], test_cases=[tc], **kwargs)
    sc.scan()
    assert sc.scan_completed
    cleanup_testsockets()

= j1939_reconnect_with_retry and j1939_get_sock error handling
from test.testsocket import TestSocket, cleanup_testsockets
from scapy.layers.can import CAN
from scapy.contrib.automotive.j1939.j1939_scanner import (
    j1939_get_sock,
    j1939_reconnect_with_retry,
)

# j1939_reconnect_with_retry exhaustion
try:
    j1939_reconnect_with_retry(lambda: (_ for _ in ()).throw(OSError("fail")), reconnect_retries=1, retry_delay=0.001)
    assert False, "Should have raised OSError"
except OSError as ex:
    assert "fail" in str(ex)

# j1939_get_sock close exception logging
class FaultySocket(TestSocket):
    should_fail = True
    def close(self):
        if self.should_fail:
            raise OSError("failed to close")
        super(FaultySocket, self).close()

faulty = FaultySocket(CAN)
faulty.closed = True
reconn_sock = FaultySocket(CAN)
with j1939_get_sock(faulty, reconnect_handler=lambda: reconn_sock) as s:
    pass

faulty.should_fail = False
reconn_sock.should_fail = False
cleanup_testsockets()

= rts_probe raw byte fallback and direct ECU_ID match
from test.testsocket import TestSocket, cleanup_testsockets
from scapy.layers.can import CAN
from scapy.contrib.automotive.j1939.j1939_scanner import (
    j1939_scan_rts_probe,
    j1939_scan_ecu_id,
    J1939_PGN_ECU_ID,
    J1939_ACK_CTRL_NACK,
)
from scapy.contrib.j1939 import (
    j1939_to_can_id,
    J1939_PGN_TP_CM,
    J1939_TP_CTRL_CTS,
    J1939_PGN_ACK,
)

# 1. Direct ECU ID match (non-BAM)
s_ecu = TestSocket(CAN)
ecu_id = j1939_to_can_id(6, 0, 0, (J1939_PGN_ECU_ID >> 8) & 0xFF, J1939_PGN_ECU_ID & 0xFF, 0x20)
s_ecu.ins.send(bytes(CAN(identifier=ecu_id, flags="extended", data=b"ECU_DATA*")))
res_ecu = j1939_scan_ecu_id(s_ecu, src_addrs=[0xF1], listen_time=0.05)
assert 0x20 in res_ecu
cleanup_testsockets()

# 2. rts_probe raw byte CTS and ACK fallbacks
s_rts_cts = TestSocket(CAN)
cts_id = j1939_to_can_id(7, 0, 0, (J1939_PGN_TP_CM >> 8) & 0xFF, 0xF9, 0x20)
cts_raw = bytes([J1939_TP_CTRL_CTS, 2, 1, 0xFF, 0xFF, 0xFF, 0x00, 0x00])
s_rts_cts.ins.send(bytes(CAN(identifier=cts_id, flags="extended", data=cts_raw)))
res_cts = j1939_scan_rts_probe(s_rts_cts, scan_range=[0x20], src_addrs=[0xF9], sniff_time=0.05)
assert 0x20 in res_cts
cleanup_testsockets()

s_rts_ack = TestSocket(CAN)
ack_id = j1939_to_can_id(6, 0, 0, (J1939_PGN_ACK >> 8) & 0xFF, 0xF9, 0x20)
ack_raw = bytes([J1939_ACK_CTRL_NACK, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0x00, 0x00])
s_rts_ack.ins.send(bytes(CAN(identifier=ack_id, flags="extended", data=ack_raw)))
res_ack = j1939_scan_rts_probe(s_rts_ack, scan_range=[0x20], src_addrs=[0xF9], sniff_time=0.05)
assert 0x20 in res_ack
cleanup_testsockets()

