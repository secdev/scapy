= uds: stop_event aborts scan early
def test_uds_stop_event():
    from threading import Event
    sock = TestSocket(CAN)
    stop = Event()
    stop.set()
    found = j1939_scan_uds(sock, scan_range=range(0x00, 0xFF),
                           sniff_time=0.0, stop_event=stop, skip_functional=True)
    assert found == {}, "stop_event set: no probes should be sent"
    cleanup_testsockets()

test_uds_stop_event()

