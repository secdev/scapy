= uds: records SA when UDS negative response (03 7F 3E) is received (Physical)
def test_uds_negative_response():
    sock = TestSocket(CAN)
    # Inject a fake UDS TesterPresent negative response (NRC 0x12) from SA=0x32
    # directed to scanner src_addr=0xF9
    resp_can_id = j1939_to_can_id(6, 0, 0, J1939_PF_DIAG_A, 0xF9, 0x32)
    sock.ins.send(bytes(CAN(identifier=resp_can_id, flags="extended",
                            data=b'\x03\x7f\x3e\x12' + b'\xff' * 4)))
    found = j1939_scan_uds(sock, scan_range=[0x32], sniff_time=0.1,
                           noise_ids=set(), skip_functional=True,
                           src_addrs=[0xF9])
    assert 0x32 in found, "Expected SA=0x32 (Negative Response), got: {}".format(
        [hex(k) for k in found])
    assert len(found[0x32]) == 1
    cleanup_testsockets()
    #
    sock2 = TestSocket(CAN)
    sock2.ins.send(bytes(CAN(identifier=resp_can_id, flags="extended",
                             data=b'\x03\x7f\x3e\x99' + b'\xff' * 4)))
    found2 = j1939_scan_uds(sock2, scan_range=[0x32], sniff_time=0.1,
                            noise_ids=set(), skip_functional=True,
                            src_addrs=[0xF9])
    assert 0x32 in found2, "Any NRC (e.g. 0x99) should confirm response to probe"
    cleanup_testsockets()

test_uds_negative_response()

