# Factory (reconnect_handler) API

= unicast: reconnect_handler factory is only called when socket is not working

created_socks = []
def _rec_factory():
    s = TestSocket(CAN)
    created_socks.append(s)
    return s

main_sock = TestSocket(CAN)
main_sock.close()
j1939_scan_unicast(main_sock, scan_range=[0x10, 0x20], src_addrs=[0xF9],
                   sniff_time=0.01, reconnect_handler=_rec_factory)
assert len(created_socks) == 2, "Expected 2 sockets created (1 per DA)"
assert all(s.closed for s in created_socks), "All per-iteration sockets should be closed"
cleanup_testsockets()

open_sock = TestSocket(CAN)
created_socks_open = []
def _rec_factory_open():
    s = TestSocket(CAN)
    created_socks_open.append(s)
    return s

j1939_scan_unicast(open_sock, scan_range=[0x10, 0x20], src_addrs=[0xF9],
                   sniff_time=0.01, reconnect_handler=_rec_factory_open)
assert len(created_socks_open) == 0, "reconnect_handler should not be called when socket is open"
assert not open_sock.closed, "Main socket should not be closed"
cleanup_testsockets()
True

