def test_passive_collects_sas():
    sock = TestSocket(CAN)
    for sa_val in [0x10, 0x20, 0x30]:
        noise_can_id = j1939_to_can_id(6, 0, 0, J1939_PF_ADDRESS_CLAIMED, J1939_GLOBAL_ADDRESS, sa_val)
        sock.ins.send(bytes(CAN(identifier=noise_can_id, flags="extended",
                                data=b'\x00' * 8)))
