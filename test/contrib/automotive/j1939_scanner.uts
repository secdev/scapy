def test_ecu_id_noise_filtering():
    sock = TestSocket(CAN)
    ecu_pgn_le = bytes(J1939Request(req_pgn=J1939_PGN_ECU_ID))
    # SA=0x20 is noise; SA=0x21 is new
    for sa_val in [0x20, 0x21]:
        bam_can_id = j1939_to_can_id(6, 0, 0, J1939_TP_CM_PF, J1939_GLOBAL_ADDRESS, sa_val)
        bam_payload = bytes([0x20, 0x0A, 0x00, 0x02, 0xFF]) + ecu_pgn_le
        sock.ins.send(bytes(CAN(identifier=bam_can_id, flags="extended",
                                data=bam_payload)))
    found = j1939_scan_ecu_id(sock, src_addrs=[0xF9], listen_time=0.2, noise_ids={0x20})
    assert 0x20 not in found, "SA=0x20 is noise and must be suppressed"
    assert 0x21 in found, "SA=0x21 (not noise) should be found"
    cleanup_testsockets()

test_ecu_id_noise_filtering()

