with slow_sock_xcp._serial_lock:
    for _ in range(2):
        slow_sock_xcp._serial_buffer.append(bytes(CAN(identifier=0x18FE0099, flags="extended", data=b"\x01" * 8)))
    resp_id = j1939_to_can_id(6, 0, 0, 0xEF, 0x3F, 0x50)
    slow_sock_xcp._serial_buffer.append(bytes(CAN(identifier=resp_id, flags="extended", data=bytes([J1939_XCP_POSITIVE_RESPONSE]) + b"\x00" * 7)))

tc_xcp = J1939_XCP_TestCase()
sc_xcp = J1939_Scanner(
    slow_sock_xcp,
    scan_range=target_das_xcp,
