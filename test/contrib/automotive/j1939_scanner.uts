    j1939_scan_ecu_id,
    j1939_scan_rts_probe,
    j1939_scan_uds,
    j1939_scan_xcp,
)
from test.testsocket import TestSocket, cleanup_testsockets

def make_factory():
    return TestSocket(CAN)

j1939_scan_passive(TestSocket(CAN), listen_time=0.01, reconnect_handler=make_factory)
cleanup_testsockets()

j1939_scan_ecu_id(TestSocket(CAN), src_addrs=[0xF9], listen_time=0.01, reconnect_handler=make_factory)
cleanup_testsockets()

j1939_scan_rts_probe(TestSocket(CAN), scan_range=[0x20], src_addrs=[0xF9], sniff_time=0.01, reconnect_handler=make_factory)
cleanup_testsockets()

j1939_scan_uds(TestSocket(CAN), scan_range=[0x20], src_addrs=[0xF9], broadcast_listen_time=0.01, sniff_time=0.01, reconnect_handler=make_factory)
cleanup_testsockets()

j1939_scan_xcp(TestSocket(CAN), scan_range=[0x20], src_addrs=[0xF9], sniff_time=0.01, reconnect_handler=make_factory)
cleanup_testsockets()
True

= j1939 scanner: _rx packet filtering for non-extended, loopback, and empty frames
from scapy.contrib.automotive.j1939.j1939_scanner import (
    j1939_scan_passive,
    j1939_scan_ecu_id,
    j1939_scan_unicast,
    j1939_scan_rts_probe,
    j1939_scan_uds,
    j1939_scan_xcp,
    J1939_GLOBAL_ADDRESS,
)
from test.testsocket import TestSocket, cleanup_testsockets

# ecu_id: non-extended, wrong PS, short data (<8 bytes)
s = TestSocket(CAN)
s.ins.send(bytes(CAN(identifier=0x123, flags="", data=b"\x00"*8)))
bad_ps = j1939_to_can_id(7, 0, 0, J1939_TP_CM_PF, 0x10, 0x20)
s.ins.send(bytes(CAN(identifier=bad_ps, flags="extended", data=bytes([0x20, 10, 0, 2, 0xFF, 0xC5, 0xFD, 0x00]))))
bam_global = j1939_to_can_id(7, 0, 0, J1939_TP_CM_PF, J1939_GLOBAL_ADDRESS, 0x20)
s.ins.send(bytes(CAN(identifier=bam_global, flags="extended", data=b"\x20\x01\x02")))
res = j1939_scan_ecu_id(s, src_addrs=[0xF9], listen_time=0.01)
assert len(res) == 0
cleanup_testsockets()

# unicast: non-extended frame
s = TestSocket(CAN)
s.ins.send(bytes(CAN(identifier=0x123, flags="", data=b"\x00"*8)))
res = j1939_scan_unicast(s, scan_range=[0x20], src_addrs=[0xF9], sniff_time=0.01)
assert len(res) == 0
cleanup_testsockets()

# rts_probe: non-extended, loopback sa == ps, empty data
s = TestSocket(CAN)
s.ins.send(bytes(CAN(identifier=0x123, flags="", data=b"\x00"*8)))
loopback_id = j1939_to_can_id(7, 0, 0, J1939_TP_CM_PF, 0xF9, 0xF9)
s.ins.send(bytes(CAN(identifier=loopback_id, flags="extended", data=bytes([0x11, 2, 1, 0xFF, 0xFF, 0xFF, 0x00, 0x00]))))
empty_id = j1939_to_can_id(7, 0, 0, J1939_TP_CM_PF, 0xF9, 0x20)
s.ins.send(bytes(CAN(identifier=empty_id, flags="extended", data=b"")))
res = j1939_scan_rts_probe(s, scan_range=[0x20], src_addrs=[0xF9], sniff_time=0.01)
assert len(res) == 0
cleanup_testsockets()

# uds functional: non-extended and noise SA
s = TestSocket(CAN)
s.ins.send(bytes(CAN(identifier=0x123, flags="", data=b"\x00"*8)))
func_id = j1939_to_can_id(6, 0, 0, 0xDB, 0xF9, 0x30)
s.ins.send(bytes(CAN(identifier=func_id, flags="extended", data=b"\x02\x7e\x00\xff\xff\xff\xff\xff")))
res = j1939_scan_uds(s, scan_range=[0x20], src_addrs=[0xF9], noise_ids={0x30},
                     broadcast_listen_time=0.01, sniff_time=0.01)
assert len(res) == 0
cleanup_testsockets()

# uds physical: non-extended frame
s_nonext = TestSocket(CAN)
s_nonext.ins.send(bytes(CAN(identifier=0x123, flags="", data=b"\x00"*8)))
res_p = j1939_scan_uds(s_nonext, scan_range=[0x20], src_addrs=[0xF9], skip_functional=True, sniff_time=0.01)
assert len(res_p) == 0
cleanup_testsockets()

# xcp: non-extended in physical
s = TestSocket(CAN)
s.ins.send(bytes(CAN(identifier=0x123, flags="", data=b"\x00"*8)))
res = j1939_scan_xcp(s, scan_range=[0x20], src_addrs=[0xF9], sniff_time=0.01)
assert len(res) == 0
cleanup_testsockets()

= j1939 scanner: stop_event triggers inside callbacks and loops
from threading import Event
from scapy.contrib.automotive.j1939.j1939_scanner import (
    j1939_scan_passive,
    j1939_scan_addr_claim,
    j1939_scan_ecu_id,
    j1939_scan_unicast,
    j1939_scan_rts_probe,
    j1939_scan_uds,
    j1939_scan_xcp,
)
from test.testsocket import TestSocket, cleanup_testsockets

# passive: stop_event aborts rx
evt = Event()
evt.set()
s = TestSocket(CAN)
s.ins.send(bytes(CAN(identifier=0x18FECA10, flags="extended", data=b"\x00"*8)))
res = j1939_scan_passive(s, listen_time=0.01, stop_event=evt)
assert len(res) == 0
cleanup_testsockets()

evt = Event()
class StopOnSendSocket(TestSocket):
    def send(self, pkt):
        super().send(pkt)
        evt.set()

# addr_claim: stop_event in rx callback and src_addrs break
s = StopOnSendSocket(CAN)
s.ins.send(bytes(CAN(identifier=0x18EEFF20, flags="extended", data=b"\x00"*8)))
j1939_scan_addr_claim(s, src_addrs=[0xF1, 0xF2], listen_time=0.01, stop_event=evt)
cleanup_testsockets()

# ecu_id: stop_event in rx callback and src_addrs break
evt.clear()
s = StopOnSendSocket(CAN)
s.ins.send(bytes(CAN(identifier=0x18ECFF20, flags="extended", data=bytes([0x20, 10, 0, 2, 0xFF, 0xC5, 0xFD, 0x00]))))
j1939_scan_ecu_id(s, src_addrs=[0xF1, 0xF2], listen_time=0.01, stop_event=evt)
cleanup_testsockets()

# unicast: stop_event in scan_range and src_addrs break
evt.clear()
s = StopOnSendSocket(CAN)
j1939_scan_unicast(s, scan_range=[0x20, 0x21], src_addrs=[0xF1, 0xF2], sniff_time=0.01, stop_event=evt)
cleanup_testsockets()

# rts_probe: stop_event in scan_range and src_addrs break
evt.clear()
s = StopOnSendSocket(CAN)
j1939_scan_rts_probe(s, scan_range=[0x20, 0x21], src_addrs=[0xF1, 0xF2], sniff_time=0.01, stop_event=evt)
cleanup_testsockets()

# uds functional: stop_event in functional rx and functional src_addrs break
evt.clear()
s = StopOnSendSocket(CAN)
s.ins.send(bytes(CAN(identifier=0x18DBFFF1, flags="extended", data=b"\x02\x7e\x00\xff\xff\xff\xff\xff")))
j1939_scan_uds(s, scan_range=[0x20], src_addrs=[0xF1, 0xF2], broadcast_listen_time=0.01, sniff_time=0.01, stop_event=evt)
cleanup_testsockets()

# uds physical: stop_event in physical src_addrs and reqs break
evt.clear()
s = StopOnSendSocket(CAN)
j1939_scan_uds(s, scan_range=[0x20], src_addrs=[0xF1, 0xF2], skip_functional=True, sniff_time=0.01, stop_event=evt)
cleanup_testsockets()

# xcp: stop_event in scan_range and src_addrs break
evt.clear()
s = StopOnSendSocket(CAN)
j1939_scan_xcp(s, scan_range=[0x20, 0x21], src_addrs=[0xF1, 0xF2], sniff_time=0.01, stop_event=evt)
cleanup_testsockets()
True

+ J1939 Diagnostic layers — DiagA and DiagB tests

= J1939DiagA and J1939DiagB structure and answers()
from scapy.contrib.j1939 import (
    J1939,
    J1939DiagA,
    J1939DiagB,
    J1939_PGN_DIAG_A,
    J1939_PGN_DIAG_B,
)
assert J1939DiagA.PGN == 0xDA00
assert J1939DiagB.PGN == 0xDB00

da_resp = J1939DiagA(data=b"\x02\x7e\x00")
da_req = J1939DiagA(data=b"\x02\x3e\x00")
db_req = J1939DiagB(data=b"\x02\x3e\x00")
db_resp = J1939DiagB(data=b"\x02\x7e\x00")

# Positive and negative UDS correlation for DiagA and DiagB
assert da_resp.answers(db_req) == 1
assert da_resp.answers(da_req) == 1
assert da_resp.answers(da_resp) == 0
assert db_resp.answers(db_req) == 1
assert db_resp.answers(da_req) == 1
assert db_resp.answers(db_resp) == 0
assert db_req.answers(db_req) == 0
assert db_req.answers(da_resp) == 0
assert da_req.answers(da_req) == 0

# J1939 stacked packets correlation
req_func = J1939(pgn=0xDB00, src=0x10, dst=0xFF) / J1939DiagB(data=b"\x02\x3e\x00")
resp_phys = J1939(pgn=0xDA00, src=0x20, dst=0x10) / J1939DiagA(data=b"\x02\x7e\x00")
assert resp_phys.answers(req_func) == 1
assert resp_phys[J1939DiagA].answers(req_func) == 1
assert resp_phys[J1939DiagA].answers(req_func[J1939DiagB]) == 1

req_phys = J1939(pgn=0xDA00, src=0x10, dst=0x20) / J1939DiagA(data=b"\x02\x3e\x00")
assert resp_phys.answers(req_phys) == 1
assert resp_phys[J1939DiagA].answers(req_phys) == 1
assert resp_phys[J1939DiagA].answers(req_phys[J1939DiagA]) == 1

# Negative response matching on DiagA and DiagB
resp_nr = J1939(pgn=0xDA00, src=0x20, dst=0x10) / J1939DiagA(data=b"\x03\x7f\x3e\x22")
assert resp_nr.answers(req_phys) == 1
assert resp_nr[J1939DiagA].answers(req_phys) == 1
assert resp_nr[J1939DiagA].answers(da_req) == 1
assert resp_nr[J1939DiagA].answers(db_req) == 1
assert resp_nr[J1939DiagA].answers(resp_nr[J1939DiagA]) == 0

db_nr = J1939DiagB(data=b"\x03\x7f\x3e\x22")
assert db_nr.answers(db_req) == 1
assert db_nr.answers(da_req) == 1
assert db_nr.answers(db_nr) == 0

# DiagnosticSessionControl (0x10) subfunction matching
dsc_req = J1939DiagA(data=b"\x02\x10\x01")
dsc_resp = J1939DiagA(data=b"\x06\x50\x01\x00\x32\x01\xf4")
dsc_resp_bad = J1939DiagA(data=b"\x06\x50\x02\x00\x32\x01\xf4")
dsc_nr = J1939DiagA(data=b"\x03\x7f\x10\x12")
assert dsc_resp.answers(dsc_req) == 1
assert dsc_resp_bad.answers(dsc_req) == 0
assert dsc_nr.answers(dsc_req) == 1
assert dsc_resp.answers(da_req) == 0

# ReadDataByIdentifier (0x22) dataIdentifier matching
rdbi_req = J1939DiagB(data=b"\x03\x22\x01\x00")
rdbi_resp = J1939DiagA(data=b"\x05\x62\x01\x00\x12\x34")
rdbi_resp_bad = J1939DiagA(data=b"\x05\x62\x02\x00\x12\x34")
assert rdbi_resp.answers(rdbi_req) == 1
assert rdbi_resp_bad.answers(rdbi_req) == 0
assert rdbi_resp.answers(dsc_req) == 0

# Direct UDS layer stacking
from scapy.contrib.automotive.uds import UDS
uds_stacked_req = J1939DiagA() / UDS(b"\x3e\x00")
uds_stacked_resp = J1939DiagA() / UDS(b"\x7e\x00")
uds_stacked_wrong = J1939DiagA() / UDS(b"\x62\x00\x00")
assert uds_stacked_resp.answers(uds_stacked_req) == 1
assert uds_stacked_wrong.answers(uds_stacked_req) == 0
assert uds_stacked_resp.answers(uds_stacked_resp) == 0
assert uds_stacked_resp.answers(da_req) == 1
assert da_resp.answers(uds_stacked_req) == 1

# Raw format without length prefix (padded)
raw_req = J1939DiagA(data=b"\x3e\x00\xff\xff\xff\xff\xff\xff")
raw_resp = J1939DiagA(data=b"\x7e\x00\xff\xff\xff\xff\xff\xff")
assert raw_resp.answers(raw_req) == 1
assert raw_resp.answers(da_req) == 1
assert da_resp.answers(raw_req) == 1

# Response Pending (NRC 0x78) configuration behavior
from scapy.config import conf
nr_pending = J1939DiagA(data=b"\x03\x7f\x3e\x78")
assert nr_pending.answers(da_req) == 0
conf.contribs.setdefault("UDS", {})["treat-response-pending-as-answer"] = True
try:
    assert nr_pending.answers(da_req) == 1
finally:
    conf.contribs["UDS"]["treat-response-pending-as-answer"] = False

# Payload service identifier verification: mismatched positive response SID
resp_wrong_sid = J1939(pgn=0xDA00, src=0x20, dst=0x10) / J1939DiagA(data=b"\x03\x62\x00\x00")
assert resp_wrong_sid.answers(req_phys) == 0
assert resp_wrong_sid[J1939DiagA].answers(req_phys) == 0

# Payload service identifier verification: negative response to a different service
resp_wrong_nr = J1939(pgn=0xDA00, src=0x20, dst=0x10) / J1939DiagA(data=b"\x03\x7f\x22\x22")
assert resp_wrong_nr.answers(req_phys) == 0
assert resp_wrong_nr[J1939DiagA].answers(req_phys) == 0

# Address verification: unrelated diagnostic traffic between other nodes must NOT match
unrelated_phys = J1939(pgn=0xDA00, src=0x30, dst=0x40) / J1939DiagA(data=b"\x02\x7e\x00")
assert resp_phys.answers(unrelated_phys) == 0
assert resp_phys[J1939DiagA].answers(unrelated_phys) == 0
assert unrelated_phys.answers(req_phys) == 0
assert unrelated_phys[J1939DiagA].answers(req_phys) == 0
assert unrelated_phys.answers(req_func) == 0

# Wrong source address must NOT match directed request
wrong_sa_resp = J1939(pgn=0xDA00, src=0x30, dst=0x10) / J1939DiagA(data=b"\x02\x7e\x00")
assert wrong_sa_resp.answers(req_phys) == 0
assert wrong_sa_resp[J1939DiagA].answers(req_phys) == 0

# Self echo must NOT match
echo_resp = J1939(pgn=0xDA00, src=0x10, dst=0x20) / J1939DiagA(data=b"\x02\x7e\x00")
assert echo_resp.answers(req_phys) == 0
assert echo_resp[J1939DiagA].answers(req_phys) == 0

from scapy.contrib.isotp.isotp_soft_socket import TimeoutScheduler
_ts = TimeoutScheduler._thread
TimeoutScheduler.clear()
if _ts is not None and _ts.is_alive():
    _ts.join(timeout=1.0)

True

+ Core Scan Execution Engines tests

= _j1939_scan_broadcast_loop basic operation, matching, noise suppression, and stop_event
from threading import Event
from scapy.contrib.automotive.j1939.j1939_scanner import (
    _j1939_scan_broadcast_loop,
    J1939ScanResult,
    J1939Request,
)
from scapy.contrib.j1939 import (
    J1939,
    J1939_GLOBAL_ADDRESS,
)
from test.testsocket import TestSocket, cleanup_testsockets

# 1. Matching and result collection
s = TestSocket(CAN)
resp_pkt = J1939(pgn=0xFECA, src=0x20, dst=0xFF, data=b"\x00" * 8)
s.ins.send(bytes(CAN(identifier=0x18FECA20, flags="extended", data=b"\x00" * 8)))

res = _j1939_scan_broadcast_loop(
    sock=s,
    src_addrs=[0xF1],
    build_probes=lambda sa: [J1939(pgn=0xEA00, dst=J1939_GLOBAL_ADDRESS, src=sa) / J1939Request(req_pgn=0xFECA)],
    match_response=lambda rcv: rcv.pgn == 0xFECA,
    log_name="test_bcast",
    listen_time=0.01,
)
assert 0x20 in res
assert len(res[0x20]) == 1
assert res[0x20][0].scanner_src == 0xF1
cleanup_testsockets()

# 2. Noise suppression
s = TestSocket(CAN)
s.ins.send(bytes(CAN(identifier=0x18FECA20, flags="extended", data=b"\x00" * 8)))
res_noise = _j1939_scan_broadcast_loop(
    sock=s,
    src_addrs=[0xF1],
    build_probes=lambda sa: [J1939(pgn=0xEA00, dst=J1939_GLOBAL_ADDRESS, src=sa) / J1939Request(req_pgn=0xFECA)],
    match_response=lambda rcv: rcv.pgn == 0xFECA,
    log_name="test_bcast",
    noise_ids={0x20},
    listen_time=0.01,
)
assert len(res_noise) == 0
cleanup_testsockets()

# 3. stop_event abortion
evt = Event()
evt.set()
s = TestSocket(CAN)
s.ins.send(bytes(CAN(identifier=0x18FECA20, flags="extended", data=b"\x00" * 8)))
res_stop = _j1939_scan_broadcast_loop(
    sock=s,
    src_addrs=[0xF1, 0xF2],
    build_probes=lambda sa: [J1939(pgn=0xEA00, dst=J1939_GLOBAL_ADDRESS, src=sa) / J1939Request(req_pgn=0xFECA)],
    match_response=lambda rcv: rcv.pgn == 0xFECA,
    log_name="test_bcast",
    stop_event=evt,
    listen_time=0.01,
)
assert len(res_stop) == 0
cleanup_testsockets()
True

= _j1939_scan_sweep_loop basic operation, range matching, and stop_event
from threading import Event
from scapy.contrib.automotive.j1939.j1939_scanner import (
    _j1939_scan_sweep_loop,
    J1939ScanResult,
    J1939Request,
)
from scapy.contrib.j1939 import (
    J1939,
)
from test.testsocket import TestSocket, cleanup_testsockets

# 1. Matching and response collection
s = TestSocket(CAN)
s.ins.send(bytes(CAN(identifier=0x18EEFFF1, flags="extended", data=b"\x00" * 8)))

def probe(j_sock, da, sa):
    req = J1939(pgn=0xEA00, dst=da, src=sa) / J1939Request(req_pgn=0xEE00)
    return j_sock.sr1(req, timeout=0.1, verbose=False)

res = _j1939_scan_sweep_loop(
    sock=s,
    scan_range=[0xF1],
    src_addrs=[0xF9],
    default_src_addrs=[0xF9],
    probe_step=probe,
    log_name="test_sweep",
    sniff_time=0.1,
)
assert 0xF1 in res
assert len(res[0xF1]) == 1
assert res[0xF1][0].scanner_src == 0xF9
cleanup_testsockets()

# 2. Noise suppression
s = TestSocket(CAN)
s.ins.send(bytes(CAN(identifier=0x18EEFFF1, flags="extended", data=b"\x00" * 8)))
res_noise = _j1939_scan_sweep_loop(
    sock=s,
    scan_range=[0xF1],
    src_addrs=[0xF9],
    default_src_addrs=[0xF9],
    probe_step=probe,
    log_name="test_sweep",
    noise_ids={0xF1},
    sniff_time=0.01,
)
assert len(res_noise) == 0
cleanup_testsockets()

# 3. stop_event
evt = Event()
evt.set()
s = TestSocket(CAN)
s.ins.send(bytes(CAN(identifier=0x18EEFFF1, flags="extended", data=b"\x00" * 8)))
res_stop = _j1939_scan_sweep_loop(
    sock=s,
    scan_range=[0xF1, 0xF2],
    src_addrs=[0xF9],
    default_src_addrs=[0xF9],
    probe_step=probe,
    log_name="test_sweep",
    stop_event=evt,
    sniff_time=0.01,
)
assert len(res_stop) == 0
cleanup_testsockets()


= j1939_check_rx_filter_warning detects mismatched SA
from unittest.mock import patch
from scapy.layers.can import CAN
from test.testsocket import TestSocket, cleanup_testsockets
from scapy.contrib.automotive.j1939.j1939_scanner import j1939_check_rx_filter_warning
from scapy.contrib.j1939 import j1939_to_can_id
warns_rx = []
dummy_sock = TestSocket(CAN)
with patch("scapy.contrib.automotive.j1939.j1939_scanner.log_j1939.warning", side_effect=lambda msg, *args: warns_rx.append(msg % args if args else msg)):
    pkt_match = CAN(identifier=j1939_to_can_id(6, 0, 0, 0xEE, 0xFF, 0x20), flags="extended")
    j1939_check_rx_filter_warning(pkt_match, 0x20, [dummy_sock])
    assert len(warns_rx) == 0
    pkt_mismatch = CAN(identifier=j1939_to_can_id(6, 0, 0, 0xEE, 0xFF, 0x25), flags="extended")
    j1939_check_rx_filter_warning(pkt_mismatch, 0x20, [dummy_sock])
    assert len(warns_rx) == 1
    assert "0x20" in warns_rx[0]

cleanup_testsockets()

from scapy.contrib.isotp.isotp_soft_socket import TimeoutScheduler
_ts = TimeoutScheduler._thread
TimeoutScheduler.clear()
if _ts is not None and _ts.is_alive():
    _ts.join(timeout=1.0)

True



