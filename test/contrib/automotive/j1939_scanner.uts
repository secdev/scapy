from test.testsocket import TestSocket, cleanup_testsockets
from scapy.contrib.automotive.j1939.j1939_scanner import (
    j1939_scan,
)
sock = TestSocket(CAN)
# 11-bit standard CAN ID (should be ignored)
sock.ins.send(bytes(CAN(identifier=0x123, flags="", data=b"\x01\x02")))
# 29-bit noise ID (should be ignored)
noise_id = j1939_to_can_id(6, 0, 0, 0xFE, 0xCA, 0x10)
sock.ins.send(bytes(CAN(identifier=noise_id, flags="extended", data=b"\x00\x00\x11\x22\x33\x44")))
# Valid frame from 0x20
valid_id = j1939_to_can_id(6, 0, 0, 0xEE, 0xFF, 0x20)
sock.ins.send(bytes(CAN(identifier=valid_id, flags="extended", data=b"\x01\x00\x00\x00\x00\x00\x00\x90")))

# methods=None tests L1344
res = j1939_scan(
    sock,
    methods=None,
    scan_range=[0x20],
    src_addrs=[0xF9],
    noise_ids={noise_id},
    broadcast_listen_time=0.01,
    sniff_time=0.01,
