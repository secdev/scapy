)
from scapy.contrib.j1939 import j1939_to_can_id

slow_sock_uds = SlowTestSocket(
    CAN,
    frame_delay=0.005,
    mux_throttle=0.001,
    serial_timeout=0.1,
    read_time_limit=0.02,
    interface_name="slcan",
)
target_das_uds = [0x40]
with slow_sock_uds._serial_lock:
    for _ in range(2):
        slow_sock_uds._serial_buffer.append(bytes(CAN(identifier=0x18FE0099, flags="extended", data=b"\x01" * 8)))
    resp_id = j1939_to_can_id(6, 0, 0, 0xDA, 0xF9, 0x40)
    slow_sock_uds._serial_buffer.append(bytes(CAN(identifier=resp_id, flags="extended", data=b"\x02\x7e\x00\xff\xff\xff\xff\xff")))

tc_uds = J1939_UDS_TestCase()
