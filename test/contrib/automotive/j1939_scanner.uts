+ Early exit (stop_filter) regression tests
~ conf

= unicast: sniff exits early when response found (stop_filter)
def test_unicast_early_exit():
    import time
    sock = TestSocket(CAN)
    resp_can_id = j1939_to_can_id(6, 0, 0, J1939_PF_ADDRESS_CLAIMED, J1939_GLOBAL_ADDRESS, 0x42)
    sock.ins.send(bytes(CAN(identifier=resp_can_id, flags="extended", data=b'\x00' * 8)))
    t0 = time.monotonic()
    found = j1939_scan_unicast(sock, scan_range=[0x42], sniff_time=5.0, src_addrs=[0xF9])
    elapsed = time.monotonic() - t0
    assert 0x42 in found, "Expected SA=0x42, got: {}".format([hex(k) for k in found])
    assert elapsed < 2.0, "Sniff should exit early, took {:.1f}s (max 2.0s)".format(elapsed)
    cleanup_testsockets()

test_unicast_early_exit()

