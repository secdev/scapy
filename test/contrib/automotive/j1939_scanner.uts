% Regression tests for J1939 CA Scanner
~ automotive_comm scanner

+ Configuration
~ conf

= Imports
from scapy.layers.can import CAN
from scapy.contrib.j1939 import (
    J1939,
    J1939Request,
    J1939_GLOBAL_ADDRESS,
    J1939_NULL_ADDRESS,
    J1939_PGN_ACK,
    J1939_PGN_ADDRESS_CLAIMED,
    J1939_PGN_DIAG_A,
    J1939_PGN_DIAG_B,
    J1939_PGN_REQUEST,
    J1939_PGN_TP_CM,
    J1939_TP_CM_RTS,
    J1939_TP_CTRL_ABORT,
    J1939_TP_CTRL_BAM,
    J1939_TP_CTRL_CTS,
    J1939_TP_CTRL_RTS,
    can_id_to_j1939,
    j1939_to_can_id,
)
from scapy.contrib.automotive.j1939.j1939_scanner import (
    J1939_ACK_CTRL_ACCESS_DENIED,
    J1939_ACK_CTRL_CANNOT_RESPOND,
    J1939_ACK_CTRL_NACK,
    J1939_DEFAULT_BITRATE,
    J1939_DEFAULT_BUSLOAD,
    J1939_DIAGADAPTERS_ADDRESSES,
    J1939_PGN_ECU_ID,
    J1939_PGN_XCP,
    J1939_UDS_TESTER_PRESENT_REQS,
    J1939_XCP_CONNECT_REQ,
    J1939_SCAN_METHODS,
    J1939_XCP_POSITIVE_RESPONSE,
    J1939_XCP_SRC_ADDRS,
    J1939ScanResult,
    j1939_inter_probe_delay,
    j1939_sa_filter,
    j1939_scan,
    j1939_scan_addr_claim,
    j1939_scan_ecu_id,
    j1939_scan_passive,
    j1939_scan_rts_probe,
    j1939_scan_uds,
    j1939_scan_unicast,
    j1939_scan_xcp,
)
from scapy.error import Scapy_Exception
from test.testsocket import TestSocket, SlowTestSocket, cleanup_testsockets

J1939_PF_ACK = (J1939_PGN_ACK >> 8) & 0xFF
J1939_PF_ADDRESS_CLAIMED = (J1939_PGN_ADDRESS_CLAIMED >> 8) & 0xFF
J1939_PF_DIAG_A = (J1939_PGN_DIAG_A >> 8) & 0xFF
J1939_PF_DIAG_B = (J1939_PGN_DIAG_B >> 8) & 0xFF
J1939_PF_REQUEST = (J1939_PGN_REQUEST >> 8) & 0xFF
J1939_PF_XCP = (J1939_PGN_XCP >> 8) & 0xFF
J1939_TP_CM_PF = (J1939_PGN_TP_CM >> 8) & 0xFF

= Redirect logging
import logging
from scapy.error import log_runtime
from io import StringIO
log_stream = StringIO()
handler = logging.StreamHandler(log_stream)
log_runtime.addHandler(handler)
j1939_logger = logging.getLogger("scapy.contrib.automotive.j1939")
