= J1939_Scanner: broadcast test cases (addr_claim, ecu_id) over super slow slcan
from test.testsocket import SlowTestSocket, cleanup_testsockets
from scapy.layers.can import CAN
from scapy.contrib.automotive.j1939.j1939_scanner import (
    J1939_Scanner,
    J1939_AddrClaim_TestCase,
    J1939_EcuId_TestCase,
    J1939_PGN_ECU_ID,
)
from scapy.contrib.j1939 import (
    j1939_to_can_id,
    J1939_PGN_ADDRESS_CLAIMED,
    J1939_GLOBAL_ADDRESS,
)

slow_sock = SlowTestSocket(
    CAN,
    frame_delay=0.005,
    mux_throttle=0.001,
    serial_timeout=0.1,
    read_time_limit=0.02,
    interface_name="slcan",
)
with slow_sock._serial_lock:
    for _ in range(2):
        slow_sock._serial_buffer.append(bytes(CAN(identifier=0x18FE0099, flags="extended", data=b"\x01" * 8)))
    pf_claim = (J1939_PGN_ADDRESS_CLAIMED >> 8) & 0xFF
    claim_id1 = j1939_to_can_id(6, 0, 0, pf_claim, J1939_GLOBAL_ADDRESS, 0x10)
    slow_sock._serial_buffer.append(bytes(CAN(identifier=claim_id1, flags="extended", data=b"\x10" * 8)))
    claim_id2 = j1939_to_can_id(6, 0, 0, pf_claim, J1939_GLOBAL_ADDRESS, 0x20)
    slow_sock._serial_buffer.append(bytes(CAN(identifier=claim_id2, flags="extended", data=b"\x20" * 8)))

tc_ac = J1939_AddrClaim_TestCase()
sc_ac = J1939_Scanner(
    slow_sock,
    test_cases=[tc_ac],
    J1939_AddrClaim_TestCase_kwargs={"broadcast_listen_time": 0.4, "src_addrs": [0xF9]},
)
sc_ac.scan()
assert sc_ac.scan_completed
res_ac = sc_ac.get_results()
assert 0x10 in res_ac and 0x20 in res_ac
cleanup_testsockets()

slow_sock_ecu = SlowTestSocket(
    CAN,
    frame_delay=0.005,
    mux_throttle=0.001,
    serial_timeout=0.1,
    read_time_limit=0.02,
    interface_name="slcan",
)
with slow_sock_ecu._serial_lock:
    for _ in range(2):
        slow_sock_ecu._serial_buffer.append(bytes(CAN(identifier=0x18FE0099, flags="extended", data=b"\x01" * 8)))
    pf_ecu = (J1939_PGN_ECU_ID >> 8) & 0xFF
    ps_ecu = J1939_PGN_ECU_ID & 0xFF
    ecu_id = j1939_to_can_id(6, 0, 0, pf_ecu, ps_ecu, 0x30)
    slow_sock_ecu._serial_buffer.append(bytes(CAN(identifier=ecu_id, flags="extended", data=b"ECUID***")))

tc_ei = J1939_EcuId_TestCase()
sc_ei = J1939_Scanner(
    slow_sock_ecu,
    test_cases=[tc_ei],
    J1939_EcuId_TestCase_kwargs={"broadcast_listen_time": 0.4, "src_addrs": [0xF9]},
)
sc_ei.scan()
assert sc_ei.scan_completed
res_ei = sc_ei.get_results()
assert 0x30 in res_ei
cleanup_testsockets()

= J1939_Scanner: unicast sweep test cases (unicast, rts_probe) over super slow slcan
from test.testsocket import SlowTestSocket, cleanup_testsockets
from scapy.layers.can import CAN
from scapy.contrib.automotive.j1939.j1939_scanner import (
    J1939_Scanner,
    J1939_Unicast_TestCase,
    J1939_RtsProbe_TestCase,
)
from scapy.contrib.j1939 import (
    j1939_to_can_id,
    J1939_PGN_ADDRESS_CLAIMED,
    J1939_PGN_TP_CM,
    J1939_TP_CTRL_CTS,
    J1939_GLOBAL_ADDRESS,
)

slow_sock_uni = SlowTestSocket(
    CAN,
    frame_delay=0.005,
    mux_throttle=0.001,
    serial_timeout=0.1,
    read_time_limit=0.02,
    interface_name="slcan",
)
target_das_uni = [0x15, 0x25]
pf_claim = (J1939_PGN_ADDRESS_CLAIMED >> 8) & 0xFF
with slow_sock_uni._serial_lock:
    for da in target_das_uni:
        for _ in range(2):
            slow_sock_uni._serial_buffer.append(bytes(CAN(identifier=0x18FE0099, flags="extended", data=b"\x01" * 8)))
        resp_id = j1939_to_can_id(6, 0, 0, pf_claim, J1939_GLOBAL_ADDRESS, da)
        slow_sock_uni._serial_buffer.append(bytes(CAN(identifier=resp_id, flags="extended", data=b"\x00" * 8)))

tc_uni = J1939_Unicast_TestCase()
sc_uni = J1939_Scanner(
    slow_sock_uni,
    scan_range=target_das_uni,
    test_cases=[tc_uni],
    J1939_Unicast_TestCase_kwargs={"sniff_time": 1.0, "src_addrs": [0xF9]},
)
sc_uni.scan()
assert sc_uni.scan_completed
res_uni = sc_uni.get_results()
assert 0x15 in res_uni and 0x25 in res_uni
cleanup_testsockets()

slow_sock_rts = SlowTestSocket(
    CAN,
    frame_delay=0.005,
    mux_throttle=0.001,
    serial_timeout=0.1,
    read_time_limit=0.02,
    interface_name="slcan",
)
target_das_rts = [0x30]
pf_tp = (J1939_PGN_TP_CM >> 8) & 0xFF
with slow_sock_rts._serial_lock:
    for _ in range(2):
        slow_sock_rts._serial_buffer.append(bytes(CAN(identifier=0x18FE0099, flags="extended", data=b"\x01" * 8)))
    resp_id = j1939_to_can_id(7, 0, 0, pf_tp, 0xF9, 0x30)
    cts_raw = bytes([J1939_TP_CTRL_CTS, 2, 1, 0xFF, 0xFF, 0xFF, 0x00, 0x00])
    slow_sock_rts._serial_buffer.append(bytes(CAN(identifier=resp_id, flags="extended", data=cts_raw)))

tc_rts = J1939_RtsProbe_TestCase()
sc_rts = J1939_Scanner(
    slow_sock_rts,
    scan_range=target_das_rts,
    test_cases=[tc_rts],
    J1939_RtsProbe_TestCase_kwargs={"sniff_time": 1.0, "src_addrs": [0xF9]},
)
sc_rts.scan()
assert sc_rts.scan_completed
res_rts = sc_rts.get_results()
assert 0x30 in res_rts
cleanup_testsockets()

