def test_dm_pgn_factory():
    from scapy.contrib.automotive.j1939.j1939_dm_scanner import (
        j1939_scan_dm, J1939_DM_PGNS,
    )
    pgn = J1939_DM_PGNS["DM1"]
    dm1_pf = (pgn >> 8) & 0xFF
    dm1_ps = pgn & 0xFF
    sock = TestSocket(CAN)
    resp_id = j1939_to_can_id(6, 0, 0, dm1_pf, dm1_ps, 0x42)
    sock.ins.send(bytes(CAN(identifier=resp_id, flags="extended", data=b'\x00' * 8)))
    def _factory():
        return sock
    result = j1939_scan_dm(_factory(), target_da=0x42, dms=["DM1"],
                           sniff_time=0.5, reconnect_handler=_factory)
    assert "DM1" in result and result["DM1"].supported, "Reconnect should find DM1 supported"
    assert result["DM1"].name == "DM1"
    cleanup_testsockets()

test_dm_pgn_factory()
True

