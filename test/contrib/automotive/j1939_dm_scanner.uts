+ General PGN Request Scanner and J1939_ECU_VIN_AM

= J1939_ECU_VIN_AM make_reply directly
vin_am = J1939_ECU_VIN_AM(ecu_addr=0x20, vin="1M8GDM9A_KP042788*")
req_vin = CAN(identifier=j1939_can_id(6, 0xEA, 0x20, 0xF9), flags="extended", data=b"\xe4\xfe\x00")
rep = vin_am.make_reply(req_vin)
assert rep is not None
_, pf, ps, sa = j1939_decode_can_id(rep.identifier)
assert pf == 0xEC
assert sa == 0x20
assert rep.data[0] == 0x10
tp_pgn = rep.data[5] | (rep.data[6] << 8) | (rep.data[7] << 16)
assert tp_pgn == 0xFEE4

= J1939_ECU_VIN_AM single-frame make_reply
vin_am_short = J1939_ECU_VIN_AM(ecu_addr=0x20, vin=b"12345678", tp_mode="none")
rep_short = vin_am_short.make_reply(req_vin)
assert rep_short is not None
_, pf, ps, sa = j1939_decode_can_id(rep_short.identifier)
assert pf == 0xFE
assert ps == 0xE4
assert rep_short.data == b"12345678"

= J1939_ECU_VIN_AM single-PGN query via J1939Socket .sr1()
from scapy.contrib.automotive.j1939 import J1939Socket
with TestSocket(CAN) as tester_can, TestSocket(CAN) as ecu_sock:
    tester_can.pair(ecu_sock)
    am = J1939_ECU_VIN_AM(ecu_addr=0x20, vin="1M8GDM9A_KP042788*")
    t, stop_evt = am.start_bg(ecu_sock)
    try:
        tester_sock = J1939Socket(tester_can, src_addr=0xF9, include_tp_cm=True)
        # Query VIN PGN using standard .sr1()
        req = J1939Request(req_pgn=J1939_PGN_VIN, dst=0x20)
        ans = tester_sock.sr1(req, timeout=0.2, verbose=False)
        assert ans is not None
        tp_cm = J1939_TP_CM(ans.data) if getattr(ans, "data", None) else ans
        assert tp_cm.pgn == J1939_PGN_VIN

        # Query unsupported PGN -> returns NACK
        req_unsupp = J1939Request(req_pgn=0xFECC, dst=0x20)
        ans_unsupp = tester_sock.sr1(req_unsupp, timeout=0.2, verbose=False)
        assert ans_unsupp is not None
        assert ans_unsupp.pgn == J1939_PGN_ACK
    finally:
        stop_evt.set()
        t.join(timeout=1.0)
        cleanup_testsockets()

= J1939_ECU_VIN_AM scanned with j1939_scan_pgns (multi-PGN dict and list)
with TestSocket(CAN) as tester_sock, TestSocket(CAN) as ecu_sock:
    tester_sock.pair(ecu_sock)
    am = J1939_ECU_VIN_AM(ecu_addr=0x20, vin="1M8GDM9A_KP042788*")
    t, stop_evt = am.start_bg(ecu_sock)
    try:
        # Dict mapping
        res_dict = j1939_scan_pgns(
            tester_sock, target_da=0x20,
            pgns={"VIN": J1939_PGN_VIN, "DM1": 0xFECA},
            sniff_time=0.1,
        )
        assert res_dict["VIN"].supported is True
        assert res_dict["VIN"].pgn == J1939_PGN_VIN
        assert res_dict["DM1"].supported is False
        assert res_dict["DM1"].error == "NACK"

        # List mapping
        res_list = j1939_scan_pgns(
            tester_sock, target_da=0x20,
            pgns=[J1939_PGN_VIN, 0xFECA],
            sniff_time=0.1,
        )
        assert res_list[J1939_PGN_VIN].supported is True
        assert res_list[0xFECA].supported is False
        assert res_list[0xFECA].error == "NACK"
    finally:
        stop_evt.set()
        t.join(timeout=1.0)
        cleanup_testsockets()

= J1939_ECU_VIN_AM single-frame detected by j1939_scan_pgns
with TestSocket(CAN) as tester_sock, TestSocket(CAN) as ecu_sock:
    tester_sock.pair(ecu_sock)
    am = J1939_ECU_VIN_AM(ecu_addr=0x20, vin=b"VIN12345", tp_mode="none")
    t, stop_evt = am.start_bg(ecu_sock)
    try:
        res = j1939_scan_pgns(tester_sock, target_da=0x20, pgns={"VIN": J1939_PGN_VIN}, sniff_time=0.1)["VIN"]
        assert res.supported is True
        assert res.pgn == J1939_PGN_VIN
        assert res.packet is not None
        assert res.packet.data == b"VIN12345"
    finally:
        stop_evt.set()
        t.join(timeout=1.0)
        cleanup_testsockets()

