= j1939_scan_dm: detects multi-packet TP BAM and RTS responses in combined scan
def test_scan_dm_tp_combined():
    import threading
    with TestSocket(CAN) as sock, TestSocket(CAN) as monitor:
        sock.pair(monitor)
        def simulate_ecu():
            while True:
                pkts = monitor.sniff(count=1, timeout=0.5)
                if not pkts:
                    break
                p = pkts[0]
                _, pf, ps, sa = j1939_decode_can_id(p.identifier)
                if pf == J1939_PF_REQUEST:
                    req_pgn = p.data[0] | (p.data[1] << 8) | (p.data[2] << 16)
                    if req_pgn == J1939_DM_PGNS["DM1"]:
                        bam_id = j1939_can_id(7, J1939_TP_CM_PF, J1939_GLOBAL_ADDRESS, 0x20)
                        bam_d = bytes(J1939_TP_CM_BAM(total_size=10, num_packets=2, pgn=req_pgn))
                        sock.ins.send(bytes(CAN(identifier=bam_id, flags="extended", data=bam_d)))
                    elif req_pgn == J1939_DM_PGNS["DM19"]:
                        rts_id = j1939_can_id(7, J1939_TP_CM_PF, sa, 0x20)
                        rts_d = bytes(J1939_TP_CM_RTS(total_size=40, num_packets=6, max_packets=0xFF, pgn=req_pgn))
                        sock.ins.send(bytes(CAN(identifier=rts_id, flags="extended", data=rts_d)))
        t = threading.Thread(target=simulate_ecu)
        t.start()
        results = j1939_scan_dm(sock, target_da=0x20, dms=["DM1", "DM19"], sniff_time=0.2)
        t.join(timeout=2.0)
        assert results["DM1"].supported, "DM1 BAM should be supported"
        assert results["DM19"].supported, "DM19 RTS should be supported"
    cleanup_testsockets()

test_scan_dm_tp_combined()

