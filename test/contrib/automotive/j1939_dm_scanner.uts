= dm_scan: early exit on multiple responses and pre-set stop_event
from threading import Event
from scapy.contrib.automotive.j1939 import j1939_can_id
sock = TestSocket(CAN)
resp_id = j1939_can_id(6, 0xFE, 0xCA, 0x10)
# Send two identical response frames to exercise if result: return
sock.ins.send(bytes(CAN(identifier=resp_id, flags="extended", data=b"\x00\x00\x11\x22\x33\x44")))
sock.ins.send(bytes(CAN(identifier=resp_id, flags="extended", data=b"\x00\x00\x11\x22\x33\x44")))
res = j1939_scan_dm(sock, target_da=0x10, dms=["DM1"], sniff_time=0.05)["DM1"]
assert res.supported is True
cleanup_testsockets()

# Exercise if stop_event is not None and stop_event.is_set(): return
sock2 = TestSocket(CAN)
evt = Event()
evt.set()
sock2.ins.send(bytes(CAN(identifier=resp_id, flags="extended", data=b"\x00\x00\x11\x22\x33\x44")))
res2 = j1939_scan_dm(sock2, target_da=0x10, dms=["DM1"], sniff_time=0.05, stop_event=evt)["DM1"]
assert res2.supported is False
cleanup_testsockets()

= dm_scan: filter configuration error detection and no flood of warnings
from unittest.mock import patch
from scapy.contrib.j1939 import j1939_log
sock_dm = TestSocket(CAN)
warns_dm = []
with patch.object(j1939_log, "warning", side_effect=lambda msg, *args: warns_dm.append(msg % args if args else msg)):
    for _ in range(5):
        noise_can = CAN(identifier=j1939_can_id(6, 0xEE, 0xFF, 0x99), flags="extended", data=b"\x00" * 8)
        sock_dm.ins.send(bytes(noise_can))
    res = j1939_scan_dm(sock_dm, target_da=0x10, dms=["DM1"], sniff_time=0.05)["DM1"]

assert len(warns_dm) == 1, "Expected exactly 1 warning despite multiple noise frames in dm_scan, got %d" % len(warns_dm)
assert "0x10" in warns_dm[0]
cleanup_testsockets()
True

+ J1939 ECU Answering Machines & DM Scanner Comparisons

= Definition of J1939 ECU Answering Machines
import struct
import threading
import time
from scapy.ansmachine import AnsweringMachine
from scapy.contrib.automotive.j1939.j1939_dm_scanner import J1939_DM_PGNS, J1939_PGN_VIN
from scapy.contrib.automotive.j1939.j1939_scanner import (
    j1939_can_id,
    j1939_decode_can_id,
)
from scapy.contrib.j1939 import (
    J1939,
    J1939Request,
    J1939_GLOBAL_ADDRESS,
    J1939_PGN_TP_CM,
    J1939_TP_CM_BAM,
    J1939_TP_CM_RTS,
    J1939_TP_CTRL_CTS,
    j1939_log,
)
from scapy.layers.can import CAN
from scapy.packet import Packet
_ACK_CTRL_NACK = 0x01
_CAN_EXTENDED_FLAG = 0x4

class J1939_ECU_AnsweringMachine(AnsweringMachine):
    """J1939 ECU simulator answering machine."""
    function_name = "j1939_ecu"
    filter = None
    def __init__(
        self,
        ecu_addr=0x20,
        supported_dms=None,
        send_nack=True,
        tp_mode="none",
        response_delay=0.0,
        **kargs
    ):
        self.ecu_addr = ecu_addr
        self.supported_dms = supported_dms if supported_dms is not None else {}
        self.send_nack = send_nack
        self.tp_mode = tp_mode
        self.response_delay = response_delay
        super().__init__(**kargs)
    #
    def is_request(self, req):
        if isinstance(req, CAN):
            if not (req.flags & _CAN_EXTENDED_FLAG):
                return False
            _, pf, ps, _ = j1939_decode_can_id(req.identifier)
            if pf == J1939_PF_REQUEST and ps in (self.ecu_addr, J1939_GLOBAL_ADDRESS):
                return bool(len(req.data) >= 3)
            if (
                pf == (J1939_PGN_TP_CM >> 8)
                and ps in (self.ecu_addr, J1939_GLOBAL_ADDRESS)
                and len(req.data) >= 8
                and req.data[0] == J1939_TP_CTRL_CTS
            ):
                return True
            return False
        #
        if isinstance(req, J1939Request):
            return bool(req.dst in (self.ecu_addr, J1939_GLOBAL_ADDRESS))
        #
        if isinstance(req, J1939):
            if req.pgn == 0xEA00 and req.dst in (self.ecu_addr, J1939_GLOBAL_ADDRESS):
                return True
            if (
                req.pgn == J1939_PGN_TP_CM
                and req.dst in (self.ecu_addr, J1939_GLOBAL_ADDRESS)
            ):
                data = getattr(req, "data", None) or bytes(req.payload)
                if len(data) >= 8 and data[0] == J1939_TP_CTRL_CTS:
                    return True
        #
        return False
    #
    def make_reply(self, req):
        if self.response_delay > 0.0:
            time.sleep(self.response_delay)
        #
        sa = J1939_GLOBAL_ADDRESS
        req_pgn = 0
        #
        if isinstance(req, CAN):
            _, pf, ps, sa = j1939_decode_can_id(req.identifier)
            data = bytes(req.data)
            if (
                pf == (J1939_PGN_TP_CM >> 8)
                and len(data) >= 8
                and data[0] == J1939_TP_CTRL_CTS
            ):
                num_pkts = data[1]
                next_pkt = data[2]
                cts_pgn = data[5] | (data[6] << 8) | (data[7] << 16)
                if cts_pgn in self.supported_dms:
                    payload = self.supported_dms[cts_pgn]
                    total_pkts = (len(payload) + 6) // 7
                    dt_id = j1939_can_id(7, 0xEB, sa, self.ecu_addr)
                    dt_pkts = []
                    for seq in range(
                        next_pkt, min(total_pkts + 1, next_pkt + num_pkts)
                    ):
                        offset = (seq - 1) * 7
                        chunk = payload[offset:offset + 7]
                        chunk += b"\xff" * (7 - len(chunk))
                        dt_pkts.append(
                            CAN(
                                identifier=dt_id,
                                flags="extended",
                                data=bytes([seq]) + chunk,
                            )
                        )
                    return dt_pkts
                return None
            if len(data) >= 3:
                req_pgn = data[0] | (data[1] << 8) | (data[2] << 16)
        elif isinstance(req, J1939Request):
            sa = req.src
            req_pgn = req.req_pgn
        elif isinstance(req, J1939):
            sa = req.src
            if req.pgn == J1939_PGN_TP_CM:
                data = getattr(req, "data", None) or bytes(req.payload)
                if len(data) >= 8 and data[0] == J1939_TP_CTRL_CTS:
                    num_pkts = data[1]
                    next_pkt = data[2]
                    cts_pgn = data[5] | (data[6] << 8) | (data[7] << 16)
                    if cts_pgn in self.supported_dms:
                        payload = self.supported_dms[cts_pgn]
                        total_pkts = (len(payload) + 6) // 7
                        dt_id = j1939_can_id(7, 0xEB, sa, self.ecu_addr)
                        dt_pkts = []
                        for seq in range(
                            next_pkt, min(total_pkts + 1, next_pkt + num_pkts)
                        ):
                            offset = (seq - 1) * 7
                            chunk = payload[offset:offset + 7]
                            chunk += b"\xff" * (7 - len(chunk))
                            dt_pkts.append(
                                CAN(
                                    identifier=dt_id,
                                    flags="extended",
                                    data=bytes([seq]) + chunk,
                                )
                            )
                        return dt_pkts
                    return None
            other_data = getattr(req, "data", None) or bytes(req.payload)
            if len(other_data) >= 3:
                req_pgn = other_data[0] | (other_data[1] << 8) | (other_data[2] << 16)
        #
        if not req_pgn:
            return None
        #
        if req_pgn in self.supported_dms:
            payload = self.supported_dms[req_pgn]
            if len(payload) > 8 and self.tp_mode == "rts":
                num_pkts = (len(payload) + 6) // 7
                rts_id = j1939_can_id(7, 0xEC, sa, self.ecu_addr)
                rts_d = bytes(
                    J1939_TP_CM_RTS(
                        total_size=len(payload),
                        num_packets=num_pkts,
                        max_packets=0xFF,
                        pgn=req_pgn,
                    )
                )
                return CAN(identifier=rts_id, flags="extended", data=rts_d)
            if len(payload) > 8 and self.tp_mode == "bam":
                num_pkts = (len(payload) + 6) // 7
                bam_id = j1939_can_id(7, 0xEC, J1939_GLOBAL_ADDRESS, self.ecu_addr)
                bam_d = bytes(
                    J1939_TP_CM_BAM(
                        total_size=len(payload),
                        num_packets=num_pkts,
                        pgn=req_pgn,
                    )
                )
                return CAN(identifier=bam_id, flags="extended", data=bam_d)
            #
            pf = (req_pgn >> 8) & 0xFF
            ps = sa if pf < 0xF0 else (req_pgn & 0xFF)
            resp_id = j1939_can_id(6, pf, ps, self.ecu_addr)
            return CAN(identifier=resp_id, flags="extended", data=payload[:8])
        #
        if self.send_nack:
            nack_id = j1939_can_id(6, J1939_PF_ACK, sa, self.ecu_addr)
            nack_data = bytes(
                [_ACK_CTRL_NACK, 0xFF, 0xFF, 0xFF, 0xFF]
            ) + struct.pack("<I", req_pgn)[:3]
            return CAN(identifier=nack_id, flags="extended", data=nack_data)
        #
        return None
    #
    def send_reply(self, reply, send_function=None):
        if isinstance(reply, list):
            for r in reply:
                super().send_reply(r, send_function=send_function)
        else:
            super().send_reply(reply, send_function=send_function)
    #
    def run_worker(self, sock, stop_event):
        while not stop_event.is_set():
            try:
                pkts = sock.sniff(count=1, timeout=0.05)
                if not pkts:
                    continue
                p = pkts[0]
                if self.is_request(p):
                    reply = self.make_reply(p)
                    if reply is not None:
                        if isinstance(reply, list):
                            for r in reply:
                                sock.send(r)
                        else:
                            sock.send(reply)
            except Exception as ex:
                j1939_log.debug("J1939_ECU_AnsweringMachine worker error: %s", ex)
                break
    #
    def start_bg(self, sock):
        stop_event = threading.Event()
        t = threading.Thread(
            target=self.run_worker, args=(sock, stop_event), daemon=True
        )
        t.start()
        return t, stop_event

class J1939_ECU_HighDM_AM(J1939_ECU_AnsweringMachine):
    def __init__(self, ecu_addr=0x20, high_dm="DM50", **kargs):
        pgn = J1939_DM_PGNS.get(high_dm, 0xFD56)
        supported = {pgn: b"\x00\x00\x11\x22\x33\x44\x55\x66"}
        super().__init__(
            ecu_addr=ecu_addr,
            supported_dms=supported,
            send_nack=True,
            **kargs
        )

class J1939_ECU_Timeout_AM(J1939_ECU_AnsweringMachine):
    def __init__(self, ecu_addr=0x20, supported_dm="DM1", **kargs):
        pgn = J1939_DM_PGNS.get(supported_dm, 0xFECA)
        supported = {pgn: b"\x00\x00\x11\x22\x33\x44\x55\x66"}
        super().__init__(
            ecu_addr=ecu_addr,
            supported_dms=supported,
            send_nack=False,
            **kargs
        )

class J1939_ECU_MultiPacket_AM(J1939_ECU_AnsweringMachine):
    def __init__(self, ecu_addr=0x20, **kargs):
        supported = {0xFECA: b"\x00" * 24}
        super().__init__(
            ecu_addr=ecu_addr,
            supported_dms=supported,
            send_nack=True,
            tp_mode="rts",
            **kargs
        )

class J1939_ECU_VIN_AM(J1939_ECU_AnsweringMachine):
    def __init__(self, ecu_addr=0x20, vin="1M8GDM9A_KP042788*", tp_mode="rts", **kargs):
        vin_bytes = vin.encode("ascii") if isinstance(vin, str) else bytes(vin)
        supported = {J1939_PGN_VIN: vin_bytes}
        super().__init__(
            ecu_addr=ecu_addr,
            supported_dms=supported,
            send_nack=True,
            tp_mode=tp_mode,
            **kargs
        )

True

= J1939_ECU_AnsweringMachine basic request handling

am = J1939_ECU_AnsweringMachine(ecu_addr=0x20, supported_dms={0xFECA: b"\x11\x22\x33\x44\x55\x66\x77\x88"}, send_nack=True)
req_can = CAN(identifier=j1939_can_id(6, 0xEA, 0x20, 0xF9), flags="extended", data=b"\xca\xfe\x00")
assert am.is_request(req_can) is True

# Supported response
reply = am.make_reply(req_can)
assert reply is not None
assert reply.data == b"\x11\x22\x33\x44\x55\x66\x77\x88"

# Unsupported request -> NACK
req_unsupported = CAN(identifier=j1939_can_id(6, 0xEA, 0x20, 0xF9), flags="extended", data=b"\xcb\xfe\x00")
reply_nack = am.make_reply(req_unsupported)
assert reply_nack is not None
assert reply_nack.data[0] == 0x01
assert reply_nack.data[5:8] == b"\xcb\xfe\x00"

= J1939_ECU_HighDM_AM supports only high DM and NACKs earlier DMs
high_am = J1939_ECU_HighDM_AM(ecu_addr=0x20, high_dm="DM50")
req_dm1 = CAN(identifier=j1939_can_id(6, 0xEA, 0x20, 0xF9), flags="extended", data=b"\xca\xfe\x00")
reply_dm1 = high_am.make_reply(req_dm1)
assert reply_dm1 is not None
assert reply_dm1.data[0] == 0x01  # NACK

# DM50 request (0xFD56 -> LE bytes 0x56, 0xFD, 0x00)
req_dm50 = CAN(identifier=j1939_can_id(6, 0xEA, 0x20, 0xF9), flags="extended", data=b"\x56\xfd\x00")
reply_dm50 = high_am.make_reply(req_dm50)
assert reply_dm50 is not None
assert reply_dm50.data == b"\x00\x00\x11\x22\x33\x44\x55\x66"

= J1939_ECU_Timeout_AM returns None for unsupported requests
timeout_am = J1939_ECU_Timeout_AM(ecu_addr=0x20, supported_dm="DM1")
reply_supported = timeout_am.make_reply(req_dm1)
assert reply_supported is not None
reply_unsupported = timeout_am.make_reply(req_dm50)
assert reply_unsupported is None

# Baseline test-only .sr1() scanner and performance benchmark are commented out
# to prevent excessive test runtime in CI. Uncomment for manual benchmarking.
# def test_scan_dm_sr1(sock, target_da, dms=None, src_addr=0xF9, sniff_time=0.1): ...

= J1939_ECU_HighDM_AM scanned with in-tree scanner
with TestSocket(CAN) as tester_sock, TestSocket(CAN) as ecu_sock:
    tester_sock.pair(ecu_sock)
    am = J1939_ECU_HighDM_AM(ecu_addr=0x20, high_dm="DM50")
    t, stop_evt = am.start_bg(ecu_sock)
    try:
        res_intree = j1939_scan_dm(tester_sock, target_da=0x20, dms=["DM1", "DM50"], sniff_time=0.1)
        assert res_intree["DM1"].supported is False
        assert res_intree["DM1"].error == "NACK"
        assert res_intree["DM50"].supported is True
    finally:
        stop_evt.set()
        t.join(timeout=1.0)
        cleanup_testsockets()

= J1939_ECU_Timeout_AM scanned with in-tree scanner
with TestSocket(CAN) as tester_sock, TestSocket(CAN) as ecu_sock:
    tester_sock.pair(ecu_sock)
    am = J1939_ECU_Timeout_AM(ecu_addr=0x20, supported_dm="DM1")
    t, stop_evt = am.start_bg(ecu_sock)
    try:
        res_intree = j1939_scan_dm(tester_sock, target_da=0x20, dms=["DM1", "DM2"], sniff_time=0.1)
        assert res_intree["DM1"].supported is True
        assert res_intree["DM2"].supported is False
        assert res_intree["DM2"].error == "Timeout"
    finally:
        stop_evt.set()
        t.join(timeout=1.0)
        cleanup_testsockets()

