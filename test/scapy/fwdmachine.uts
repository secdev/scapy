class NOPFwdMachine(ForwardMachine):
    # The documentation's pass-through example, recording forwarded bytes and SNI.
    def newconn(self, ctx):
        """
        Remember the connection thread so teardown can wait for it.
        """
        self.worker = current_thread()
    def xfrmcs(self, pkt, ctx):
        """
        Record the request and SNI, then forward without modification.
        """
        self.requests.append(bytes(pkt))
        self.sni = ctx.tls_sni_name
        print(repr(pkt))
        raise self.FORWARD()
    def xfrmsc(self, pkt, ctx):
        """
        Record the upstream response before forwarding it to the client.
        """
        self.responses.append(bytes(pkt))
        print(repr(pkt))
        raise self.FORWARD()
    def run(self):
        """
        Run the relay until the test shuts down its listening socket.
        """
        try:
            super().run()
        except OSError:
            # Shutting down the listener interrupts accept() at test teardown.
            if not self.stopping.is_set():
                raise

class FwdHTTPHandler(BaseHTTPRequestHandler):
    def do_GET(self):
        """
        Record the requested path and return a fixed response.
        """
        self.server.paths.append(self.path)
        self.send_response(200)
        self.send_header("Content-Length", "9")
        # Closing after the response gives the client a definite end of stream.
        self.send_header("Connection", "close")
        self.end_headers()
        self.wfile.write(b"monitored")
    def log_message(self, format, *args):
        """
        Suppress the HTTP server's access log during tests.
        """
        pass


def run_fwd_test_client(address, root=None, client_context=None,
                        server_name="proxy.test"):
    """
    Send HTTPS through the relay and check its certificate and response.
    """
    fwd_request = b"GET /monitor HTTP/1.1\r\nHost: proxy.test\r\nConnection: close\r\n\r\n"
    if client_context is None:
        client_context = ssl.SSLContext(ssl.PROTOCOL_TLS_CLIENT)
    if root is None:
        # Model accepting the generated root's certificate warning.
        client_context.check_hostname = False
        client_context.verify_mode = ssl.CERT_NONE
    else:
        client_context.load_verify_locations(cadata=root.pem)
    # Use the successful connection for TLS instead of opening a separate probe.
    deadline = time.monotonic() + 3
    while True:
        try:
            connection = socket.create_connection(address, timeout=1)
            break
        except OSError:
            if time.monotonic() >= deadline:
                raise
            time.sleep(0.1)
    with connection:
        connection.settimeout(3)
        with client_context.wrap_socket(connection, server_hostname=server_name) as client:
            # The relay must preserve the server identity while replacing its key.
            peer = Cert(client.getpeercert(binary_form=True))
            assert peer.subject == fwd_servercrt.subject
            assert bytes(peer.tbsCertificate.validity) == bytes(fwd_servercrt.tbsCertificate.validity)
            assert peer.pubkey.der != fwd_servercrt.pubkey.der
            assert [bytes(x) for x in peer.extensions if x.extnID == "2.5.29.17"] == [bytes(x) for x in fwd_servercrt.extensions if x.extnID == "2.5.29.17"]
            # Read until the upstream closes, so truncated responses fail the check.
            client.sendall(fwd_request)
            response = b""
            while True:
                chunk = client.recv(4096)
                if not chunk:
                    break
                response += chunk
    assert b"200 OK" in response
    assert response.endswith(b"\r\n\r\nmonitored")
    return fwd_request, response

@contextmanager
def fwd_https_server(upstream_chain=True):
    """
    Yield a local HTTPS server and stop its thread when the test exits.
    """
    # OpenSSL needs the fixed certificate chain and key in files.
    fwd_serverfile = get_temp_file(autoext=".pem")
    fwd_serverkeyfile = get_temp_file(autoext=".pem")
    with open(fwd_serverfile, "w") as fd:
        fd.write(fwd_servercrt.pem)
        # Exercise both a leaf-only TLS Certificate message and a full chain.
        if upstream_chain:
            fd.write(fwd_root.pem)
    fwd_serverkey.export(fwd_serverkeyfile)
    # Let the OS choose a free port so concurrent campaigns can run independently.
    with HTTPServer(("127.0.0.1", 0), FwdHTTPHandler) as upstream:
        upstream.paths = []
        upstream_context = ssl.SSLContext(ssl.PROTOCOL_TLS_SERVER)
        upstream_context.load_cert_chain(fwd_serverfile, fwd_serverkeyfile)
        # Keep this server focused on forwarding rather than TLS session resumption.
        upstream_context.num_tickets = 0
        upstream.socket = upstream_context.wrap_socket(upstream.socket, server_side=True)
        upstream_thread = Thread(target=upstream.serve_forever, kwargs=dict(poll_interval=0.01), daemon=True)
        # Serve in parallel while the relay and client complete the request.
        upstream_thread.start()
        try:
            yield upstream
        finally:
            upstream.shutdown()
            upstream_thread.join(3)
            assert not upstream_thread.is_alive()

def run_fwd_test(machine_cls=NOPFwdMachine, root=None, rootkey=None,
                 client_context=None, server_name="proxy.test",
                 upstream_chain=True, **machine_options):
    """
    Run a client through a SERVER-mode relay to the local HTTPS server.
    """
    # A supplied CA signs the relay chain; otherwise the relay generates its root.
    fwd_rootfile = get_temp_file(autoext=".pem")
    fwd_rootkeyfile = get_temp_file(autoext=".pem")
    options = {}
    if root is not None:
        root.export(fwd_rootfile)
        rootkey.export(fwd_rootkeyfile)
        options = dict(rootcrtfile=fwd_rootfile, rootkeyfile=fwd_rootkeyfile)
    # Only the relay reaches upstream; the client connects to the relay listener.
    with fwd_https_server(upstream_chain=upstream_chain) as upstream:
        # Choose an available relay port before the client starts retrying it.
        with socket.socket() as reservation:
            reservation.bind(("127.0.0.1", 0))
            address = reservation.getsockname()
        machine = machine_cls(
            mode=ForwardMachine.MODE.SERVER, port=address[1], cls=HTTP,
            bind_address="127.0.0.1", remote_address="127.0.0.1",
            remote_port=upstream.server_port, tls=True,
            no_check_certificate=True, **dict(options, **machine_options),
        )
        machine.stopping = Event()
        machine.requests, machine.responses = [], []
        relay_thread = Thread(target=machine.run, daemon=True)
        relay_thread.start()
        try:
            fwd_request, response = run_fwd_test_client(
                address, root, client_context,
                server_name,
            )
            # Check both endpoints and the callbacks observed the same exchange.
            assert upstream.paths == ["/monitor"]
            assert b"".join(machine.requests) == fwd_request
            assert b"".join(machine.responses) == response
            assert machine.sni == server_name
        finally:
            # Unblock accept() and wait for both relay threads before the next case.
            machine.stopping.set()
            machine.ssock.shutdown(socket.SHUT_RDWR)
            machine.ssock.close()
            relay_thread.join(3)
            if hasattr(machine, "worker"):
                machine.worker.join(3)
                assert not machine.worker.is_alive()
            assert not relay_thread.is_alive()


+ HTTPS requests through a running ForwardMachine

= ForwardingMachine - Self-signed proxy CA - Upstream sends a single certificate
~ fwdmachine
run_fwd_test(upstream_chain=False)

= ForwardingMachine - Self-signed proxy CA - Upstream sends a certificate chain
~ fwdmachine
run_fwd_test(upstream_chain=True)

= ForwardingMachine - Trusted proxy CA - ECDSA - Upstream sends a single certificate
~ fwdmachine
run_fwd_test(root=fwd_root, rootkey=fwd_ec_rootkey, upstream_chain=False)

= ForwardingMachine - Trusted proxy CA - ECDSA - Upstream sends a certificate chain
~ fwdmachine
run_fwd_test(root=fwd_root, rootkey=fwd_ec_rootkey, upstream_chain=True)

= ForwardingMachine - Trusted proxy CA - RSA certificate with client verification
~ fwdmachine
run_fwd_test(root=fwd_rsa_root, rootkey=fwd_rsa_rootkey)

= ForwardingMachine - Trusted proxy CA - Ed25519 certificate with client verification
~ fwdmachine
run_fwd_test(root=fwd_ed25519_root, rootkey=fwd_ed25519_rootkey)

= ForwardingMachine - Trusted proxy CA - Ed448 certificate with client verification
~ fwdmachine
run_fwd_test(root=fwd_ed448_root, rootkey=fwd_ed448_rootkey)
