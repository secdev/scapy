from scapy.cbor.cborfields import (
    CBORF_ANY,
    CBORF_ARRAY,
    CBORF_BOOLEAN,
    CBORF_optional,
    CBOR_ABSENT,
)
from scapy.cborpacket import CBOR_Packet

class OptionalAnyThenBoolArray(CBOR_Packet):
