= Optional semantic tag with default=None builds an empty array
from scapy.cbor.cborfields import (
    CBORF_ARRAY,
    CBORF_SEMANTIC_TAG,
    CBORF_UNSIGNED_INTEGER,
    CBORF_optional,
)
from scapy.cborpacket import CBOR_Packet

class OptionalTagged(CBOR_Packet):
    CBOR_root = CBORF_ARRAY(
        CBORF_optional(
            CBORF_SEMANTIC_TAG(
                1,
                CBORF_UNSIGNED_INTEGER("value", None),
            )
        )
    )

pkt = OptionalTagged()
assert pkt.getfieldval("value") is None
assert bytes(pkt) == b"\x80"

